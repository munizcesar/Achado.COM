---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  schema?: string;
}

const { 
  title = "AchadoCerto.VIP | Reviews e Guias de Compra Independentes", 
  description = "Análises aprofundadas, testes reais e guias de compra estruturados para ajudar você a escolher os melhores produtos do mercado.",
  schema 
} = Astro.props;

// Schema Organizacional Default (Base)
const defaultSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AchadoCerto.VIP",
  "url": "https://achadocerto.vip/"
});
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Fontes (Inter) otimizadas p/ LCP -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- GA4 Setup via Gtag (Analytics & Event Tracking) -->
    <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
      
      // Função global para tracking de afiliados (High-RPM Programmatic SEO)
      window.trackAffiliateClick = function(productName, category, url) {
        gtag('event', 'affiliate_click', {
          'product_name': productName,
          'category': category,
          'outbound_url': url
        });
      }
    </script>

    <!-- Injeção de JSON-LD Schema (GEO & Semantic SEO) -->
    <script type="application/ld+json" set:html={schema || defaultSchema}></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">Achado<span>Certo</span></a>
        <nav style="display:flex; gap: 24px; font-weight: 500; font-size: 14px; color: var(--text-muted);">
          <a href="/blog">Reviews</a>
          <a href="/sobre">Nossa Metodologia</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer style="padding: 64px 0; text-align: center; border-top: 1px solid var(--border-light); margin-top: 64px; color: var(--text-muted); font-size: 14px;">
      <div class="container">
        <p>© {new Date().getFullYear()} AchadoCerto.VIP. Todos os direitos reservados.</p>
        <p style="margin-top: 8px; font-size: 13px; color: var(--text-light);">Operamos de forma independente. Compras via nossos links podem gerar comissões que financiam nossos testes.</p>
      </div>
    </footer>
  </body>
</html>
