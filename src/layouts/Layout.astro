---
import '../styles/global.css';
import '../styles/geo.css';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: object | object[];
  isArticle?: boolean;
  articleDate?: string;
  articleAuthor?: string;
}

const {
  title = 'AchadoCerto — Reviews e Guias de Compra Independentes',
  description = 'Análises aprofundadas, comparativos e guias de compra para você fazer a melhor escolha sem perder tempo nem dinheiro.',
  image = '/images/og-previa.jpg',
  schema,
  isArticle = false,
  articleDate = '',
  articleAuthor = 'Equipe AchadoCerto',
} = Astro.props;

const siteUrl = 'https://achadocerto.vip';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const ogWidth = '1200';
const ogHeight = '630';

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AchadoCertoVIP',
  url: siteUrl,
  description,
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/blog?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};

const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [defaultSchema];
const schemaData = JSON.stringify(schemaArray);
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>
  <meta name="description" content={description} />
  {isArticle && articleAuthor && <meta name="author" content={articleAuthor} />}

  <!-- Open Graph -->
  <meta property="og:type" content={isArticle ? 'article' : 'website'} />
  <meta property="og:site_name" content="AchadoCertoVIP" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={ogWidth} />
  <meta property="og:image:height" content={ogHeight} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content="pt_BR" />
  {isArticle && articleDate && <meta property="article:published_time" content={articleDate} />}
  {isArticle && articleAuthor && <meta property="article:author" content={articleAuthor} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@achadocerto" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />

