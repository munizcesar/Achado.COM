</head>
<body>

  <!-- GEO SCRIPT: detecta país e ativa banners Amazon US para visitantes internacionais -->
  <script is:inline>
  (function () {
    var CACHE_KEY = 'acv_geo';
    var CACHE_TTL = 1000 * 60 * 60 * 24;

    function applyGeo(country) {
      var isIntl = country !== 'BR';
      try { localStorage.setItem(CACHE_KEY, JSON.stringify({ country: country, ts: Date.now() })); } catch(e) {}
      if (!isIntl) return;
      document.body.classList.add('geo-intl');
    }

    function run() {
      try {
        var raw = localStorage.getItem(CACHE_KEY);
        if (raw) {
          var cached = JSON.parse(raw);
          if (Date.now() - cached.ts < CACHE_TTL) {
            applyGeo(cached.country);
            return;
          }
        }
      } catch(e) {}

      fetch('https://www.cloudflare.com/cdn-cgi/trace')
        .then(function(r) { return r.text(); })
        .then(function(txt) {
          var m = txt.match(/loc=(\w+)/);
          applyGeo(m ? m[1] : 'BR');
        })
        .catch(function() {
          fetch('https://ipapi.co/country/')
            .then(function(r) { return r.text(); })
            .then(function(c) { applyGeo(c.trim() || 'BR'); })
            .catch(function() {});
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
  })();
  </script>

