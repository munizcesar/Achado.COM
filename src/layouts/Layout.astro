    }
    .drawer-pilar-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
    .drawer-pilar-dot-beleza { background: #be185d; }
    .drawer-pilar-dot-saude  { background: #15803d; }
    .drawer-pilar-dot-casa   { background: #1d4ed8; }
    .drawer-divider { height: 1px; background: var(--c-border); margin: 0; }
    .subnav-link.subnav-pilar { font-weight: 700; color: var(--c-text); }
    .subnav-link.subnav-pilar:hover,
    .subnav-link.subnav-pilar.active { color: var(--c-brand); border-bottom-color: var(--c-brand); }
    .subnav-link.subnav-sec { font-weight: 500; color: var(--c-text-muted); font-size: .83rem; }
    .subnav-link.subnav-sec:hover { color: var(--c-text-sub); }
    .subnav-sep { display: inline-flex; align-self: center; width: 1px; height: 16px; background: var(--c-border-mid); margin: 0 2px; flex-shrink: 0; }
    .footer-social { display: flex; align-items: center; gap: 12px; margin-top: 20px; flex-wrap: wrap; }
    .social-btn { width: 42px; height: 42px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: #fff; border: 1px solid rgba(0,0,0,.08); box-shadow: var(--shadow-xs); transition: transform .2s, opacity .2s, box-shadow .2s; flex-shrink: 0; }
    .social-btn svg { width: 17px; height: 17px; }
    .social-btn:hover { transform: translateY(-1px); opacity: .96; box-shadow: var(--shadow-sm); }
    .social-x { background: #000; }
    .social-whatsapp { background: #25D366; }
    .social-instagram { background: radial-gradient(circle at 30% 107%,#fdf497 0%,#fdf497 5%,#fd5949 45%,#d6249f 60%,#285AEB 90%); }
    .brand { display: inline-flex; align-items: center; }
    @media (max-width: 480px) {
      .footer-social { gap: 10px; }
      .social-btn { width: 38px; height: 38px; }
      .social-btn svg { width: 16px; height: 16px; }
    }
  </style>

  <script is:inline>
    window.openDrawer = function() {
      document.body.classList.add('drawer-open');
      document.getElementById('drawer').setAttribute('aria-hidden', 'false');
      document.getElementById('drawerToggle').setAttribute('aria-expanded', 'true');
    };
    window.closeDrawer = function() {
      document.body.classList.remove('drawer-open');
      document.getElementById('drawer').setAttribute('aria-hidden', 'true');
      document.getElementById('drawerToggle').setAttribute('aria-expanded', 'false');
    };
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { window.closeDrawer(); window.closeMobileSearch(); }
    });
    window.openMobileSearch = function() {
      var overlay = document.getElementById('mobileSearchOverlay');
      overlay.classList.add('open');
      setTimeout(function() { document.getElementById('mobileSearchInput').focus(); }, 100);
    };
    window.closeMobileSearch = function(e) {
      if (!e || e.target === document.getElementById('mobileSearchOverlay')) {
        document.getElementById('mobileSearchOverlay').classList.remove('open');
      }
    };
    (function() {
      var inner = document.getElementById('subnavInner');
      var left  = document.getElementById('subnavArrowLeft');
      var right = document.getElementById('subnavArrowRight');
      if (!inner || !left || !right) return;
      function upd() {
        var s = inner.scrollLeft;
        var m = inner.scrollWidth - inner.clientWidth;
        if (m <= 0) { left.style.display='none'; right.style.display='none'; return; }
        left.style.display  = s > 5     ? 'flex' : 'none';
        right.style.display = s < m - 5 ? 'flex' : 'none';
      }
      left.addEventListener('click',  function() { inner.scrollBy({left:-200,behavior:'smooth'}); });
      right.addEventListener('click', function() { inner.scrollBy({left: 200,behavior:'smooth'}); });
      inner.addEventListener('scroll', upd);
      window.addEventListener('resize', upd);
      upd();
    })();
  </script>
</body>
</html>
