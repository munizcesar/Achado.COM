---
interface Props {
  whatsappImage?: string;
  telegramImage?: string;
}

const { whatsappImage, telegramImage } = Astro.props;

const WHATSAPP_URL = 'https://whatsapp.com/channel/0029VbC8hocDJ6H0vLWZlm2w';
const TELEGRAM_URL = 'https://t.me/achadocertovip';
---

<section class="channel-banner-section">
  <div class="container channel-banner-grid">

    <!-- WHATSAPP -->
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="channel-banner channel-banner--whatsapp"
      aria-label="Seguir canal do AchadoCerto no WhatsApp"
    >
      <div class="channel-banner__icon-wrap">
        <svg class="channel-banner__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
      </div>
      <div class="channel-banner__content">
        <strong class="channel-banner__title">WhatsApp</strong>
        <span class="channel-banner__desc">Receba os melhores achados em primeira mão</span>
      </div>
      <span class="channel-banner__cta">
        Seguir
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </a>

    <!-- TELEGRAM -->
    <a
      href={TELEGRAM_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="channel-banner channel-banner--telegram"
      aria-label="Seguir canal do AchadoCerto no Telegram"
    >
      <div class="channel-banner__icon-wrap">
        <svg class="channel-banner__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
      </div>
      <div class="channel-banner__content">
        <strong class="channel-banner__title">Telegram</strong>
        <span class="channel-banner__desc">Ofertas e promoções sem perder nenhuma</span>
      </div>
      <span class="channel-banner__cta">
        Entrar
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </a>

  </div>
</section>

<style>
  .channel-banner-section {
    padding: 16px 0 24px;
    background: var(--c-bg);
  }

  .channel-banner-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 960px;
    margin: 0 auto;
  }

  .channel-banner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--r-md, 8px);
    text-decoration: none;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    transition: border-color 0.18s, background 0.18s;
    min-height: 60px;
  }

  .channel-banner:hover {
    border-color: var(--c-brand-soft, #e1306c33);
    background: var(--c-surface-hover, var(--c-surface));
  }

  /* Faixa de cor lateral discreta */
  .channel-banner--whatsapp { border-left: 3px solid #25D366; }
  .channel-banner--telegram  { border-left: 3px solid #26A5E4; }

  .channel-banner__icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .channel-banner--whatsapp .channel-banner__icon-wrap { background: rgba(37,211,102,.12); }
  .channel-banner--telegram  .channel-banner__icon-wrap { background: rgba(38,165,228,.12); }

  .channel-banner__icon { width: 20px; height: 20px; }
  .channel-banner--whatsapp .channel-banner__icon { color: #25D366; }
  .channel-banner--telegram  .channel-banner__icon { color: #26A5E4; }

  .channel-banner__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .channel-banner__title {
    font-size: .9rem;
    font-weight: 700;
    color: var(--c-text);
    line-height: 1.2;
  }

  .channel-banner__desc {
    font-size: .75rem;
    color: var(--c-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .channel-banner__cta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: .78rem;
    font-weight: 600;
    color: var(--c-text-sub);
    white-space: nowrap;
    flex-shrink: 0;
    transition: gap 0.15s, color 0.15s;
  }
  .channel-banner:hover .channel-banner__cta {
    gap: 7px;
    color: var(--c-brand);
  }

  @media (max-width: 600px) {
    .channel-banner-grid { grid-template-columns: 1fr; gap: 8px; }
    .channel-banner__desc { display: none; }
    .channel-banner { padding: 10px 14px; min-height: 52px; }
  }
</style>
