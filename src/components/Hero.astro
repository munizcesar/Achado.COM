---
const products = [
  { name: 'Smartphone Samsung Galaxy A55', store: 'Mercado Livre', priceOld: 'R$ 1.299', price: 'R$ 899', badge: '-31%' },
  { name: 'Fone JBL Tune 520BT', store: 'Amazon', priceOld: 'R$ 299', price: 'R$ 179', badge: '-40%' },
  { name: 'Notebook Lenovo IdeaPad 3', store: 'Magalu', priceOld: 'R$ 3.199', price: 'R$ 2.399', badge: '-25%' },
  { name: 'Smartwatch Xiaomi Band 8', store: 'Mercado Livre', priceOld: 'R$ 399', price: 'R$ 249', badge: '-38%' },
];
---

<section class="hero">
  <div class="hero-bg-shapes" aria-hidden="true">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
  </div>

  <div class="container">
    <div class="hero-inner">

      <div class="hero-copy">
        <div class="hero-badge">
          <span class="hero-badge-dot"></span>
          Ofertas selecionadas diariamente
        </div>

        <h1 class="hero-title">
          Os melhores <em>achados do dia</em><br />
          você encontra aqui
        </h1>

        <p class="hero-desc">
          Curadoria diária de promoções reais no Mercado Livre, Magalu e Amazon.
          Ofertas selecionadas, sem spam — só o que realmente vale a pena.
        </p>

        <div class="hero-ctas">
          <a
            href="https://whatsapp.com/channel/0029VbC8hocDJ6H0vLWZlm2w"
            target="_blank" rel="noopener"
            class="btn-primary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Entrar no Canal VIP
          </a>
          <a href="/blog" class="btn-ghost">Ver todos os achados →</a>
        </div>

        <div class="hero-stats">
          <div class="hero-stat">
            <strong>+10k</strong>
            <span>Membros VIP</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat">
            <strong>Diário</strong>
            <span>Atualizado</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat">
            <strong>100%</strong>
            <span>Verificado</span>
          </div>
        </div>
      </div>

      <!-- Card produtos -->
      <div class="hero-card" aria-hidden="true">
        <div class="hero-card-header">
          <span class="live-dot"></span>
          <span class="live-label">Achados agora</span>
          <span class="live-count">{products.length} ofertas</span>
        </div>
        <div class="hero-card-list">
          {products.map(p => (
            <div class="product-row">
              <div class="product-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(249,115,22,0.7)" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <div class="product-info">
                <span class="product-name">{p.name}</span>
                <span class="product-store">{p.store}</span>
              </div>
              <div class="product-pricing">
                <span class="price-old">{p.priceOld}</span>
                <span class="price-new">{p.price}</span>
                <span class="price-badge">{p.badge}</span>
              </div>
            </div>
          ))}
        </div>
        <a href="/blog" class="hero-card-cta">Ver todos os achados →</a>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(135deg, #1e1150 0%, #2e1155 60%, #1a0f40 100%);
    padding: 5rem 0 4rem;
    overflow: hidden;
    color: #fff;
  }

  .hero-bg-shapes { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .shape { position: absolute; border-radius: 50%; }
  .shape-1 { width: 550px; height: 550px; top: -220px; right: -120px; background: radial-gradient(circle, rgba(236,72,153,0.12), transparent 70%); }
  .shape-2 { width: 350px; height: 350px; bottom: -120px; left: -80px; background: radial-gradient(circle, rgba(249,115,22,0.1), transparent 70%); }
  .shape-3 { width: 200px; height: 200px; top: 40%; right: 22%; background: radial-gradient(circle, rgba(255,255,255,0.04), transparent 70%); }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 1; }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 3rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(249,115,22,0.12);
    border: 1px solid rgba(249,115,22,0.3);
    border-radius: 100px;
    padding: 0.35rem 0.875rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #fb923c;
    margin-bottom: 1.25rem;
    width: fit-content;
  }
  .hero-badge-dot {
    width: 6px; height: 6px;
    background: #f97316;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.4); }
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .hero-title em {
    font-style: normal;
    background: linear-gradient(90deg, #f97316, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.68);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 480px;
  }

  .hero-ctas { display: flex; gap: 0.875rem; flex-wrap: wrap; margin-bottom: 2.5rem; }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #f97316, #ec4899);
    color: #fff;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 18px rgba(249,115,22,0.35);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(236,72,153,0.45);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255,255,255,0.8);
    font-weight: 600;
    font-size: 0.92rem;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.18);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .btn-ghost:hover {
    border-color: rgba(249,115,22,0.5);
    color: #fb923c;
    background: rgba(249,115,22,0.06);
  }

  .hero-stats { display: flex; align-items: center; gap: 1.25rem; }
  .hero-stat { text-align: center; }
  .hero-stat strong {
    display: block;
    font-size: 1.3rem;
    font-weight: 800;
    background: linear-gradient(90deg, #f97316, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }
  .hero-stat span {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hero-stat-divider { width: 1px; height: 32px; background: rgba(255,255,255,0.12); }

  /* Card -->
  .hero-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 18px;
    overflow: hidden;
    backdrop-filter: blur(16px);
    box-shadow: 0 24px 64px rgba(0,0,0,0.4);
  }

  .hero-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    background: rgba(249,115,22,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .live-dot {
    width: 8px; height: 8px;
    background: #f97316;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
    flex-shrink: 0;
  }
  .live-label { font-size: 0.82rem; font-weight: 700; color: #fb923c; flex: 1; }
  .live-count {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.38);
    background: rgba(255,255,255,0.07);
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
  }

  .hero-card-list { padding: 0.5rem 0; }
  .product-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    transition: background 0.15s;
  }
  .product-row:last-child { border-bottom: none; }
  .product-row:hover { background: rgba(255,255,255,0.04); }

  .product-icon {
    width: 36px; height: 36px;
    background: rgba(255,255,255,0.05);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .product-info { flex: 1; min-width: 0; }
  .product-name { display: block; font-size: 0.78rem; font-weight: 600; color: rgba(255,255,255,0.88); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .product-store { font-size: 0.68rem; color: rgba(255,255,255,0.38); }

  .product-pricing { text-align: right; flex-shrink: 0; }
  .price-old { display: block; font-size: 0.65rem; color: rgba(255,255,255,0.3); text-decoration: line-through; }
  .price-new { display: block; font-size: 0.85rem; font-weight: 700; color: #fff; }
  .price-badge {
    display: inline-block;
    background: linear-gradient(135deg, #f97316, #ec4899);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    margin-top: 0.1rem;
  }

  .hero-card-cta {
    display: block;
    text-align: center;
    padding: 0.875rem;
    background: rgba(249,115,22,0.1);
    border-top: 1px solid rgba(249,115,22,0.18);
    color: #fb923c;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }
  .hero-card-cta:hover { background: rgba(249,115,22,0.18); }

  @media (max-width: 900px) {
    .hero { padding: 3.5rem 0 3rem; }
    .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-card { max-width: 480px; }
  }
  @media (max-width: 520px) {
    .hero { padding: 2.5rem 0 2rem; }
    .hero-title { font-size: 1.75rem; }
    .hero-ctas { flex-direction: column; }
    .btn-primary, .btn-ghost { justify-content: center; }
  }
</style>
