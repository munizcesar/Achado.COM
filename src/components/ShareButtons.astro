---
/**
 * ShareButtons.astro
 * Botões de compartilhamento: WhatsApp, Facebook, Email e Share nativa (Web Share API)
 * Props:
 *  - url:   URL canônica do post (obrigatória)
 *  - title: Título do post (obrigatória)
 *  - description: Descrição curta (opcional, usada no Email)
 */
interface Props {
  url: string;
  title: string;
  description?: string;
}

const { url, title, description = '' } = Astro.props;

const encodedUrl   = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDesc  = encodeURIComponent(description);

const whatsappHref = `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const emailHref    = `mailto:?subject=${encodedTitle}&body=${encodedDesc ? encodedDesc + '%0A%0A' : ''}${encodedUrl}`;
---

<div class="share-buttons" role="group" aria-label="Compartilhar este post">
  <span class="share-label">Compartilhar:</span>

  <!-- WhatsApp -->
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn share-whatsapp"
    aria-label="Compartilhar no WhatsApp"
    title="Compartilhar no WhatsApp"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
    </svg>
    <span class="share-btn-label">WhatsApp</span>
  </a>

  <!-- Facebook -->
  <a
    href={facebookHref}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn share-facebook"
    aria-label="Compartilhar no Facebook"
    title="Compartilhar no Facebook"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
    </svg>
    <span class="share-btn-label">Facebook</span>
  </a>

  <!-- Email -->
  <a
    href={emailHref}
    class="share-btn share-email"
    aria-label="Compartilhar por e-mail"
    title="Compartilhar por e-mail"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="20" height="16" x="2" y="4" rx="2"/>
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
    </svg>
    <span class="share-btn-label">E-mail</span>
  </a>

  <!-- Web Share API (exibido apenas se suportado) -->
  <button
    class="share-btn share-native"
    id="shareNativeBtn"
    aria-label="Mais opções de compartilhamento"
    title="Compartilhar"
    style="display:none"
    type="button"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
    </svg>
    <span class="share-btn-label">Mais</span>
  </button>
</div>

<script define:vars={{ url, title, description }}>
  (function () {
    var btn = document.getElementById('shareNativeBtn');
    if (!btn) return;
    if (navigator.share) {
      btn.style.display = 'inline-flex';
      btn.addEventListener('click', function () {
        navigator.share({ title: title, text: description || title, url: url }).catch(function () {});
      });
    }
  })();
</script>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0;
  }

  .share-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-text-muted, #64748b);
    margin-right: 4px;
    white-space: nowrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
    white-space: nowrap;
  }

  .share-btn:hover,
  .share-btn:focus-visible {
    transform: translateY(-2px);
    opacity: 0.92;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
  }

  .share-btn:active {
    transform: translateY(0);
    opacity: 1;
    box-shadow: none;
  }

  /* Cores oficiais */
  .share-whatsapp  { background: #25D366; }
  .share-facebook  { background: #1877F2; }
  .share-email     { background: #6b7280; color: #fff; }
  .share-native    { background: #374151; }

  /* Em telas pequenas, oculta o label de texto */
  @media (max-width: 480px) {
    .share-btn-label { display: none; }
    .share-btn { padding: 10px 12px; }
  }
</style>
