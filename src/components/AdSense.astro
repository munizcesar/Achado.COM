---
interface Props {
  slot: string;
  format?: string;
  fullWidth?: boolean;
  maxWidth?: string;
  minHeight?: string;
  mobileMinHeight?: string;
}

const {
  slot,
  format = "auto",
  fullWidth = true,
  maxWidth = "100%",
  minHeight = "0px",
  mobileMinHeight,
} = Astro.props;
---

<div
  class="adsense-wrap"
  style={`max-width:${maxWidth}; margin:0 auto; width:100%; --ad-min-height:${minHeight}; --ad-mobile-min-height:${mobileMinHeight ?? minHeight};`}
>
  <ins class="adsbygoogle"
    style="display:block; min-height:var(--ad-min-height);"
    data-ad-client="ca-pub-8532820173012599"
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive={fullWidth ? "true" : "false"}>
  </ins>
</div>
<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>

<style>
  @media (max-width: 768px) {
    .adsense-wrap .adsbygoogle {
      min-height: var(--ad-mobile-min-height);
    }
  }
</style>
