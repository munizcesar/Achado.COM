---
interface Props {
  slot: string;
  format?: string;
  fullWidth?: boolean;
  maxWidth?: string;
}

const {
  slot,
  format = "auto",
  fullWidth = true,
  maxWidth = "100%",
} = Astro.props;
---

<div style={`max-width:${maxWidth}; margin:0 auto; width:100%;`}>
  <ins class="adsbygoogle"
    style="display:block;"
    data-ad-client="ca-pub-8532820173012599"
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive={fullWidth ? "true" : "false"}>
  </ins>
</div>
<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>
