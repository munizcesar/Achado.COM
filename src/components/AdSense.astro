---
interface Props {
  slot: string;
  format?: string;
  fullWidth?: boolean;
  maxWidth?: string;
  minHeight?: string;
  label?: boolean;
}

const {
  slot,
  format = "auto",
  fullWidth = true,
  maxWidth = "100%",
  minHeight = "90px",
  label = false,
} = Astro.props;
---

<div class="adsense-wrap" style={`max-width:${maxWidth}; width:100%; min-height:${minHeight}; margin:0 auto; box-sizing:border-box;`}>
  {label && <p class="adsense-label">Publicidade</p>}
  <ins class="adsbygoogle"
    style="display:block; width:100%;"
    data-ad-client="ca-pub-8532820173012599"
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive="true">
  </ins>
</div>
<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>

<style>
  .adsense-wrap { position: relative; }
  .adsense-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--c-text-light, #ADB5BD);
    text-align: center;
    margin: 0 0 4px;
  }
</style>
