---
interface Props {
  slot: string;
  format?: string;
  fullWidth?: boolean;
  maxWidth?: string;
  minHeight?: string;
}

const {
  slot,
  format = "auto",
  fullWidth = true,
  maxWidth = "100%",
  minHeight = "90px",
} = Astro.props;
---

<div style={`max-width:${maxWidth}; margin:0 auto; width:100%; min-height:${minHeight}; max-height:280px; overflow:hidden; box-sizing:border-box;`}>
  <ins class="adsbygoogle"
    style="display:block; width:100%; min-height:inherit; overflow:hidden;"
    data-ad-client="ca-pub-8532820173012599"
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive="false">
  </ins>
</div>
<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>
