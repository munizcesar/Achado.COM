---
interface Props {
  title: string;
  excerpt?: string;
  slug: string;
  category?: string;
  date?: string;
  image?: string;
  variant?: 'featured' | 'mini' | 'grid';
}
const {
  title,
  excerpt,
  slug,
  category = 'Blog',
  date,
  image,
  variant = 'grid',
} = Astro.props;

const href = `/blog/${slug}`;
const formattedDate = date
  ? new Date(date).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })
  : null;
---

{variant === 'featured' && (
  <article class="post-card-featured">
    {image
      ? <img src={image} alt={title} class="pcard-img" loading="eager" width="800" height="450" />
      : <div class="pcard-img pcard-img-placeholder" style="aspect-ratio:16/9">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        </div>
    }
    <div class="pcard-body">
      <div class="pcard-meta">
        <span class="pcard-category">{category}</span>
        {formattedDate && <time class="pcard-date" datetime={date}>{formattedDate}</time>}
      </div>
      <h2 class="pcard-title"><a href={href}>{title}</a></h2>
      {excerpt && <p class="pcard-excerpt">{excerpt}</p>}
      <a href={href} class="pcard-read">Ler artigo completo <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    </div>
  </article>
)}

{variant === 'mini' && (
  <article class="post-card-mini">
    {image
      ? <img src={image} alt={title} class="pcard-img" loading="lazy" width="96" height="96" />
      : <div class="pcard-img pcard-img-placeholder" style="width:96px;height:96px;flex-shrink:0">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        </div>
    }
    <div class="pcard-body">
      <div class="pcard-meta">
        <span class="pcard-category">{category}</span>
      </div>
      <h3 class="pcard-title"><a href={href}>{title}</a></h3>
      <a href={href} class="pcard-read">Ler mais</a>
    </div>
  </article>
)}

{variant === 'grid' && (
  <article class="post-card-grid">
    {image
      ? <img src={image} alt={title} class="pcard-img" loading="lazy" width="600" height="338" />
      : <div class="pcard-img pcard-img-placeholder" style="aspect-ratio:16/9">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        </div>
    }
    <div class="pcard-body">
      <div class="pcard-meta">
        <span class="pcard-category">{category}</span>
        {formattedDate && <time class="pcard-date" datetime={date}>{formattedDate}</time>}
      </div>
      <h2 class="pcard-title"><a href={href}>{title}</a></h2>
      {excerpt && <p class="pcard-excerpt">{excerpt}</p>}
    </div>
    <a href={href} class="pcard-read" style="margin: 0 20px 16px;">Ler artigo <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
  </article>
)}
