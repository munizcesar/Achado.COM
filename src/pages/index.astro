---
import Layout from '../layouts/Layout.astro';

let posts = [];
try {
  const { getCollection } = await import('astro:content');
  posts = (await getCollection('blog'))
    .filter(p => !p.data.draft)
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
} catch(e) { posts = []; }

// Último post de cada categoria (silos semânticos)
const seen = new Set();
const siloPosts = posts.filter(p => {
  const cat = p.data.category || 'Geral';
  if (seen.has(cat)) return false;
  seen.add(cat);
  return true;
});

const hero    = siloPosts[0] ?? null;
const sidebar = siloPosts.slice(1, 5);
const grid    = siloPosts.slice(5);

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<Layout>
  {hero ? (
    <!-- HERO — destaque principal (LCP otimizado) -->
    <section class="hero">
      <div class="container">
        <div class="hero-grid">

          <!-- Post em destaque -->
          <article class="hero-main">
            <a href={`/blog/${hero.slug}`} class="hero-main-img-wrap" aria-label={hero.data.title}>
              <img
                src={hero.data.image || '/placeholder.webp'}
                alt={hero.data.title}
                class="hero-main-img"
                width="820" height="461"
                loading="eager"
                fetchpriority="high"
                decoding="sync"
              />
            </a>
            <span class="hero-cat">{hero.data.category}</span>
            <h1 class="hero-title">
              <a href={`/blog/${hero.slug}`}>{hero.data.title}</a>
            </h1>
            <p class="hero-excerpt">{hero.data.description}</p>
            <a href={`/blog/${hero.slug}`} class="btn-read-full">
              Ler análise completa
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </article>

          <!-- Sidebar: últimas de cada categoria -->
          <aside class="hero-sidebar">
            <div class="hero-sidebar-header">Últimas análises</div>
            {sidebar.map(post => (
              <a href={`/blog/${post.slug}`} class="sidebar-post">
                {post.data.image
                  ? <img src={post.data.image} alt={post.data.title} class="sidebar-post-img" loading="lazy" width="72" height="54" />
                  : <div class="sidebar-post-img" style="background:var(--c-border);"></div>
                }
                <div>
                  <span class="sidebar-post-cat">{post.data.category}</span>
                  <span class="sidebar-post-title">{post.data.title}</span>
                </div>
              </a>
            ))}
          </aside>

        </div>
      </div>
    </section>
  ) : (
    <section class="section section-white">
      <div class="container">
        <div class="empty-state">
          <h2>Em breve: reviews e guias de compra</h2>
          <p>Estamos preparando análises completas para você. Volte em breve!</p>
        </div>
      </div>
    </section>
  )}

  <!-- GRID: demais categorias -->
  {grid.length > 0 && (
    <section class="section section-gray">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-label">Mais Categorias</span>
            <h2 class="section-title">Explore por assunto</h2>
          </div>
          <a href="/blog" class="section-link">
            Ver todos
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="post-grid">
          {grid.map((post, i) => (
            <article class="post-card">
              <a href={`/blog/${post.slug}`} class="post-card-img-wrap">
                <img
                  src={post.data.image || '/placeholder.webp'}
                  alt={post.data.title}
                  class="post-card-img"
                  width="600" height="400"
                  loading="lazy"
                />
              </a>
              <div class="post-card-body">
                <span class="post-card-cat">{post.data.category}</span>
                <h3 class="post-card-title">
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </h3>
                {post.data.description && (
                  <p class="post-card-excerpt">{post.data.description}</p>
                )}
              </div>
              <div class="post-card-footer">
                <time class="post-card-date" datetime={post.data.date?.toISOString?.() ?? ''}>
                  {fmtDate(post.data.date)}
                </time>
                <a href={`/blog/${post.slug}`} class="post-card-read">
                  Ler review
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
