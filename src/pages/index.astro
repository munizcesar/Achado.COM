---
import Layout from '../layouts/Layout.astro';
import ChannelBanner from '../components/ChannelBanner.astro';
import AdSense from '../components/AdSense.astro';

let posts = [];
try {
  const { getCollection } = await import('astro:content');
  posts = (await getCollection('blog'))
    .filter(p => !p.data.draft)
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
} catch(e) { posts = []; }

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}

function readingTime(body) {
  if (!body) return '2 min de leitura';
  const words = body.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} min de leitura`;
}

function normalizeCategory(cat) {
  if (!cat) return '';
  return cat.toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .trim();
}

const pilares = [
  { slug: 'beleza', label: 'Beleza & Fragr\u00e2ncias', desc: 'Perfumes, col\u00f4nias e body splash com curadoria independente.' },
  { slug: 'saude',  label: 'Sa\u00fade & Suplementos',  desc: 'Vitaminas, prote\u00ednas e suplementos testados e aprovados.' },
  { slug: 'casa',   label: 'Casa & Bem-Estar',        desc: 'Eletrodom\u00e9sticos e utilit\u00e1rios que facilitam sua rotina.' },
];

const postsByPilar = pilares.map(p => {
  const filtered = posts.filter(post => {
    const cat = normalizeCategory(post.data.category);
    const slug = normalizeCategory(p.slug);
    const mapped = cat === 'lar' ? 'casa' : cat === 'esporte' ? 'esportes' : cat;
    return mapped === slug;
  });
  return { ...p, posts: filtered, total: filtered.length };
});

// Dados para a Seção Seleção AchadoCerto
const selecaoPosts = posts.slice(0, 6).map(p => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description || '',
  category: p.data.category || 'Blog',
  image: p.data.image || '/placeholder.webp',
  readTime: readingTime(p.body),
}));
const mainPost = selecaoPosts[0] || null;
const sidebarPosts = selecaoPosts.slice(1);

const seen = new Set();
const siloPosts = posts.filter(p => {
  const cat = p.data.category || 'Geral';
  if (seen.has(cat)) return false;
  seen.add(cat);
  return true;
});
---

<Layout>

  <!-- ===================== TRUST BANNER ===================== -->
  <section class="trust-banner">
    <div class="container">
      <div class="trust-inner">
        <div class="trust-copy">
          <h2 class="trust-headline">Encontre o produto certo <em>antes</em> de comprar</h2>
          <p class="trust-sub">Curadoria honesta, comparativos reais e links diretos nas melhores lojas do Brasil.</p>
        </div>
        <div class="trust-actions">
          <form class="trust-search" action="/blog" method="get" role="search">
            <svg class="trust-search-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input type="search" name="q" placeholder="O que voc&#234; est&#225; procurando?" aria-label="Buscar produto" autocomplete="off" />
            <button type="submit" aria-label="Pesquisar">Buscar</button>
          </form>
          <div class="trust-cats">
            <a href="/categorias/beleza" class="trust-pill trust-pill-pilar">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
              Beleza
            </a>
            <a href="/categorias/saude" class="trust-pill trust-pill-pilar">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="M8.5 8.5 16 16"/></svg>
              Sa&#250;de
            </a>
            <a href="/categorias/casa" class="trust-pill trust-pill-pilar">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Casa
            </a>
            <a href="/blog" class="trust-pill trust-pill-all">
              Ver todos
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ChannelBanner />


  <!-- ===================== CURADORIA ACHADOCERTO — Selo Editorial ===================== -->
  {mainPost && (
    <section class="selecao-section">
      <!-- Background: 8 camadas de profundidade -->
      <div class="selecao-bg" aria-hidden="true">
        <div class="selecao-bg-blue"></div>
        <div class="selecao-bg-green"></div>
        <div class="selecao-bg-gold"></div>
        <div class="selecao-bg-noise"></div>
        <div class="selecao-bg-map" aria-hidden="true">
          <svg viewBox="0 0 1400 700" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Journey paths – trajetórias de descoberta conectando nós -->
            <path d="M-80 560 C120 540 200 280 380 320 C560 360 640 180 860 200 C1040 214 1140 360 1320 340 C1400 332 1470 380 1520 420" stroke="var(--c-brand, #1A56DB)" stroke-width="1.2" opacity="0.06" stroke-linecap="round"/>
            <path d="M-60 440 C180 420 260 520 460 460 C660 400 740 260 940 280 C1100 296 1200 420 1380 400" stroke="var(--c-brand, #1A56DB)" stroke-width="0.8" opacity="0.04" stroke-linecap="round"/>
            <path d="M-40 620 C240 600 340 380 540 400 C740 420 840 240 1040 260 C1200 276 1280 460 1480 440" stroke="rgba(16,185,129,0.8)" stroke-width="0.6" opacity="0.04" stroke-linecap="round"/>
            <path d="M-20 340 C160 320 280 460 480 420 C680 380 780 200 980 220 C1140 236 1240 320 1420 300" stroke="var(--c-brand, #1A56DB)" stroke-width="0.5" opacity="0.03" stroke-linecap="round"/>
            <!-- Nós do mapa – pontos luminosos nas interseções -->
            <circle cx="200" cy="280" r="3" fill="var(--c-brand, #1A56DB)" opacity="0.12"/>
            <circle cx="380" cy="320" r="2.5" fill="var(--c-brand, #1A56DB)" opacity="0.1"/>
            <circle cx="640" cy="180" r="3.5" fill="var(--c-brand, #1A56DB)" opacity="0.14"/>
            <circle cx="860" cy="200" r="2.5" fill="var(--c-brand, #1A56DB)" opacity="0.1"/>
            <circle cx="1140" cy="360" r="3" fill="var(--c-brand, #1A56DB)" opacity="0.12"/>
            <circle cx="1320" cy="340" r="2" fill="var(--c-brand, #1A56DB)" opacity="0.08"/>
            <circle cx="260" cy="520" r="2" fill="rgba(16,185,129,0.8)" opacity="0.1"/>
            <circle cx="460" cy="460" r="2.5" fill="var(--c-brand, #1A56DB)" opacity="0.1"/>
            <circle cx="740" cy="260" r="3" fill="var(--c-brand, #1A56DB)" opacity="0.12"/>
            <circle cx="940" cy="280" r="2" fill="var(--c-brand, #1A56DB)" opacity="0.08"/>
            <circle cx="1200" cy="420" r="2.5" fill="var(--c-brand, #1A56DB)" opacity="0.1"/>
            <circle cx="340" cy="380" r="2" fill="rgba(16,185,129,0.8)" opacity="0.08"/>
            <circle cx="540" cy="400" r="2.5" fill="var(--c-brand, #1A56DB)" opacity="0.1"/>
            <circle cx="840" cy="240" r="2" fill="var(--c-brand, #1A56DB)" opacity="0.08"/>
            <circle cx="1040" cy="260" r="3" fill="var(--c-brand, #1A56DB)" opacity="0.12"/>
            <!-- Glow nodes – pontos maiores com brilho -->
            <circle cx="380" cy="320" r="8" fill="var(--c-brand, #1A56DB)" opacity="0.04"/>
            <circle cx="860" cy="200" r="10" fill="var(--c-brand, #1A56DB)" opacity="0.03"/>
            <circle cx="1320" cy="340" r="7" fill="var(--c-brand, #1A56DB)" opacity="0.04"/>
          </svg>
        </div>
      </div>

      <div class="container">
        <!-- Header → Selo editorial institucional -->
        <div class="selecao-header">
          <div class="selecao-seal">
            <span class="selecao-seal-mark" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="0.5" y="0.5" width="29" height="29" rx="5" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
                <text x="15" y="19" text-anchor="middle" fill="currentColor" font-size="11" font-weight="700" font-family="system-ui, -apple-system, sans-serif" opacity="0.5" letter-spacing="0.5">AC</text>
              </svg>
            </span>
            <h2 class="selecao-title">Curadoria AchadoCerto</h2>
          </div>
          <p class="selecao-subtitle">An&aacute;lises aprofundadas e comparativos reais para voc&ecirc; decidir com seguran&ccedil;a.</p>
          <div class="selecao-ruler">
            <span class="selecao-ruler-line"></span>
            <span class="selecao-ruler-line"></span>
          </div>
        </div>

        <!-- Editorial Grid 65/35 -->
        <div class="selecao-editorial">
          <!-- Feature principal (65%) -->
          <article class="selecao-feature">
            <a href={`/blog/${mainPost.slug}`} class="selecao-feature-link">
              <div class="selecao-feature-figure">
                <img src={mainPost.image} alt={mainPost.title} class="selecao-feature-img" width="900" height="560" loading="eager" />
                <div class="selecao-feature-shine" aria-hidden="true"></div>
              </div>
              <div class="selecao-feature-body">
                <div class="selecao-feature-meta">
                  <span class="selecao-feature-cat">{mainPost.category}</span>
                  <span class="selecao-feature-time">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {mainPost.readTime}
                  </span>
                </div>
                <h3 class="selecao-feature-headline">{mainPost.title}</h3>
                {mainPost.description && <p class="selecao-feature-desc">{mainPost.description}</p>}
                <span class="selecao-feature-cta">
                  <span class="selecao-feature-cta-text">Ver an&aacute;lise completa</span>
                  <span class="selecao-feature-cta-arrow" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </span>
              </div>
            </a>
          </article>

          <!-- Sidebar Mini Features (35%) -->
          {sidebarPosts.length > 0 && (
            <aside class="selecao-minilist" aria-label="Mais an&aacute;lises da sele&ccedil;&atilde;o">
              <div class="selecao-minilist-header">
                <h3 class="selecao-minilist-heading">Nesta edi&ccedil;&atilde;o</h3>
              </div>
              <div class="selecao-minilist-items">
                {sidebarPosts.map((post, i) => (
                  <a href={`/blog/${post.slug}`} class="selecao-minilist-item" style={`--i: ${i}`}>
                    <div class="selecao-minilist-figure">
                      <img src={post.image} alt={post.title} class="selecao-minilist-img" width="72" height="72" loading="lazy" />
                    </div>
                    <div class="selecao-minilist-body">
                      <span class="selecao-minilist-cat">{post.category}</span>
                      <span class="selecao-minilist-title">{post.title}</span>
                    </div>
                    <svg class="selecao-minilist-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
                  </a>
                ))}
              </div>
            </aside>
          )}
        </div>
      </div>
    </section>
  )}


  <!-- ===================== SEÇÕES POR PILAR ===================== -->
  {postsByPilar.map((pilar, i) => (
    <>
      {pilar.posts.length > 0 && (
        <section class={`pilar-section ${i % 2 === 0 ? 'pilar-section-alt' : ''}`}>
          <div class="container">
            <div class="section-header">
              <div class="section-header-left">
                <div class="section-icon-wrap">
                  {pilar.slug === 'beleza' && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
                      <path d="M20 3v4M22 5h-4M4 17v2M5 18H3"/>
                    </svg>
                  )}
                  {pilar.slug === 'saude' && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/>
                      <path d="M8.5 8.5 16 16"/>
                    </svg>
                  )}
                  {pilar.slug === 'casa' && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                      <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                  )}
                </div>
                <div>
                  <span class="section-label">Categoria</span>
                  <h2 class="section-title">{pilar.label}</h2>
                </div>
              </div>
              <a href={`/categorias/${pilar.slug}`} class="section-link">
                Ver todos ({pilar.total})
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
            <div class="post-grid">
              {pilar.posts.slice(0, 3).map(post => (
                <article class="post-card">
                  <a href={`/blog/${post.slug}`} class="post-card-img-wrap">
                    <img src={post.data.image || '/placeholder.webp'} alt={post.data.title}
                      class="post-card-img" width="600" height="400" loading="lazy" />
                  </a>
                  <div class="post-card-body">
                    <span class="post-card-cat">{post.data.category}</span>
                    <h3 class="post-card-title"><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
                    {post.data.description && <p class="post-card-excerpt">{post.data.description}</p>}
                  </div>
                  <div class="post-card-footer">
                    <time class="post-card-date" datetime={post.data.date?.toISOString?.() ?? ''}>
                      {fmtDate(post.data.date)}
                    </time>
                    <a href={`/blog/${post.slug}`} class="post-card-read">
                      Ler review
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}
    </>
  ))}


  <!-- ===================== HERO ROTATIVO ===================== -->
  {siloPosts.length > 0 && (
    <section class="hero" id="heroSection">
      <div class="container">
        <div class="section-header" style="margin-bottom:24px;">
          <div>
            <span class="section-label">Destaques</span>
            <h2 class="section-title">An&#225;lise em destaque</h2>
          </div>
        </div>
        <div class="hero-grid">
          <article class="hero-main" id="heroMain" style="opacity:0; transition: opacity 0.45s ease;">
            <a id="heroImgLink" href="#" class="hero-main-img-wrap">
              <img id="heroImg" src="" alt="" class="hero-main-img" width="820" height="547" loading="lazy" decoding="async" />
            </a>
            <span id="heroCat" class="hero-cat"></span>
            <h2 class="hero-title"><a id="heroTitleLink" href="#"></a></h2>
            <p id="heroExcerpt" class="hero-excerpt"></p>
            <a id="heroBtn" href="#" class="btn-read-full">
              Ler an&#225;lise completa
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </article>
          <aside class="hero-sidebar">
            <div class="hero-sidebar-header">Outras an&#225;lises</div>
            <div id="sidebarPosts"></div>
          </aside>
        </div>
      </div>
    </section>
  )}

  <div class="ad-between-sections">
    <div class="container">
      <AdSense slot="2844415754" format="auto" fullWidth={true} minHeight="80px" mobileMinHeight="72px" />
    </div>
  </div>


  <div id="postsPool" style="display:none" aria-hidden="true">
    {siloPosts.map((p, i) => (
      <div
        data-idx={i}
        data-slug={p.slug}
        data-title={p.data.title}
        data-desc={p.data.description || ''}
        data-cat={p.data.category || ''}
        data-img={p.data.image || '/placeholder.webp'}
        data-url={`/blog/${p.slug}`}
      ></div>
    ))}
  </div>

  <script>
    const container = document.getElementById('postsPool');
    const items = container ? Array.from(container.children) : [];
    const pool = items.map(el => ({ slug: el.dataset.slug, title: el.dataset.title, desc: el.dataset.desc, cat: el.dataset.cat, img: el.dataset.img, url: el.dataset.url }));
    if (pool.length === 0) {
      document.getElementById('heroSection')?.remove();
    } else {
      const idx = Math.floor(Math.random() * pool.length);
      const hero = pool[idx];
      const sidebar = [...pool.slice(0, idx), ...pool.slice(idx + 1)].slice(0, 4);
      document.getElementById('heroImgLink').href = hero.url;
      const img = document.getElementById('heroImg'); img.src = hero.img; img.alt = hero.title;
      document.getElementById('heroCat').textContent = hero.cat;
      const tl = document.getElementById('heroTitleLink'); tl.href = hero.url; tl.textContent = hero.title;
      document.getElementById('heroExcerpt').textContent = hero.desc;
      document.getElementById('heroBtn').href = hero.url;
      requestAnimationFrame(() => { document.getElementById('heroMain').style.opacity = '1'; });
      const sidebarEl = document.getElementById('sidebarPosts');
      sidebar.forEach(post => {
        const a = document.createElement('a'); a.href = post.url; a.className = 'sidebar-post';
        a.innerHTML = `<img src="${post.img}" alt="" class="sidebar-post-img" loading="lazy" width="64" height="48" /><div><span class="sidebar-post-cat">${post.cat}</span><span class="sidebar-post-title">${post.title}</span></div>`;
        sidebarEl.appendChild(a);
      });
    }
  </script>



</Layout>

<style>
  /* ===== AD BETWEEN SECTIONS ===== */
  .ad-between-sections {
    background: var(--c-bg, #f8f9fa);
    padding: 20px 0;
    border-top: 1px solid var(--c-border, #e2e8f0);
    border-bottom: 1px solid var(--c-border, #e2e8f0);
  }

  /* ===== TRUST BANNER ===== */
  .trust-banner { background: linear-gradient(135deg,#1a1a2e 0%,#16213e 60%,#0f3460 100%); padding:48px 0 40px; border-bottom:3px solid var(--c-brand,#E1306C); }
  .trust-inner { display:flex; flex-direction:column; gap:28px; }
  .trust-badge { display:inline-block; background:rgba(225,48,108,.15); color:#f48fb1; border:1px solid rgba(225,48,108,.35); font-size:.72rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; padding:4px 12px; border-radius:20px; margin-bottom:10px; }
  .trust-headline { font-size:clamp(1.5rem,4vw,2.1rem); font-weight:800; color:#fff; line-height:1.2; margin:0 0 10px; }
  .trust-headline em { font-style:normal; color:#E1306C; }
  .trust-sub { color:#a0aec0; font-size:.95rem; margin:0; max-width:520px; }
  .trust-search { display:flex; align-items:center; background:rgba(255,255,255,.07); border:1.5px solid rgba(255,255,255,.15); border-radius:10px; padding:0 6px 0 14px; gap:8px; max-width:520px; transition:border-color .2s; }
  .trust-search:focus-within { border-color:#E1306C; background:rgba(255,255,255,.1); }
  .trust-search-icon { color:#a0aec0; flex-shrink:0; }
  .trust-search input { flex:1; background:none; border:none; outline:none; color:#fff; font-size:.95rem; padding:12px 0; font-family:inherit; }
  .trust-search input::placeholder { color:#718096; }
  .trust-search button { background:#E1306C; color:#fff; border:none; border-radius:7px; padding:8px 18px; font-size:.85rem; font-weight:700; cursor:pointer; white-space:nowrap; font-family:inherit; transition:background .2s; }
  .trust-search button:hover { background:#c2185b; }
  .trust-cats { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }

  .trust-pill {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    min-width: 108px; height: 38px; padding: 0 16px;
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12);
    color: #e2e8f0; font-size: .82rem; font-weight: 500; border-radius: 20px;
    text-decoration: none; white-space: nowrap; letter-spacing: .02em;
    transition: background .18s, border-color .18s, color .18s, transform .15s, box-shadow .18s;
  }
