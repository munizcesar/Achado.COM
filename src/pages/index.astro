---
import Layout from '../layouts/Layout.astro';

let posts = [];
try {
  const { getCollection } = await import('astro:content');
  posts = (await getCollection('blog'))
    .filter(p => !p.data.draft)
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
} catch(e) { posts = []; }

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}

const seen = new Set();
const siloPosts = posts.filter(p => {
  const cat = p.data.category || 'Geral';
  if (seen.has(cat)) return false;
  seen.add(cat);
  return true;
});

const gridPosts = posts.filter(p => !siloPosts.includes(p)).slice(0, 6);
---

<Layout>

  <!-- ===================== TRUST BANNER ===================== -->
  <section class="trust-banner">
    <div class="container">
      <div class="trust-inner">

        <div class="trust-copy">
          <span class="trust-badge">&#10003; Reviews independentes</span>
          <h2 class="trust-headline">Encontre o produto certo <em>antes</em> de comprar</h2>
          <p class="trust-sub">Curadoria honesta, comparativos reais e links diretos nas melhores lojas do Brasil.</p>
        </div>

        <div class="trust-actions">
          <form class="trust-search" action="/blog" method="get" role="search">
            <svg class="trust-search-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input type="search" name="q" placeholder="O que voc&#234; est&#225; procurando?" aria-label="Buscar produto" autocomplete="off" />
            <button type="submit" aria-label="Pesquisar">Buscar</button>
          </form>

          <div class="trust-cats">
            <a href="/categorias/tech" class="trust-pill">
              <span class="pill-icon">💻</span>Tech
            </a>
            <a href="/categorias/automotivo" class="trust-pill">
              <span class="pill-icon">🚗</span>Auto
            </a>
            <a href="/categorias/casa" class="trust-pill">
              <span class="pill-icon">🏠</span>Casa
            </a>
            <a href="/categorias/saude" class="trust-pill">
              <span class="pill-icon">💊</span>Sa&#250;de
            </a>
            <a href="/categorias/beleza" class="trust-pill">
              <span class="pill-icon">✨</span>Beleza
            </a>
            <a href="/categorias/esportes" class="trust-pill">
              <span class="pill-icon">⚽</span>Esportes
            </a>
            <a href="/blog" class="trust-pill trust-pill-all">
              Ver todos
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <style>
    .trust-banner {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
      padding: 48px 0 40px;
      border-bottom: 3px solid #E1306C;
    }
    .trust-inner {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .trust-badge {
      display: inline-block;
      background: rgba(225,48,108,.15);
      color: #f48fb1;
      border: 1px solid rgba(225,48,108,.35);
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 20px;
      margin-bottom: 10px;
    }
    .trust-headline {
      font-size: clamp(1.5rem, 4vw, 2.1rem);
      font-weight: 800;
      color: #fff;
      line-height: 1.2;
      margin: 0 0 10px;
    }
    .trust-headline em {
      font-style: normal;
      color: #E1306C;
    }
    .trust-sub {
      color: #a0aec0;
      font-size: .95rem;
      margin: 0;
      max-width: 520px;
    }
    .trust-search {
      display: flex;
      align-items: center;
      background: rgba(255,255,255,.07);
      border: 1.5px solid rgba(255,255,255,.15);
      border-radius: 10px;
      padding: 0 6px 0 14px;
      gap: 8px;
      max-width: 520px;
      transition: border-color .2s;
    }
    .trust-search:focus-within {
      border-color: #E1306C;
      background: rgba(255,255,255,.1);
    }
    .trust-search-icon { color: #a0aec0; flex-shrink: 0; }
    .trust-search input {
      flex: 1;
      background: none;
      border: none;
      outline: none;
      color: #fff;
      font-size: .95rem;
      padding: 12px 0;
      font-family: inherit;
    }
    .trust-search input::placeholder { color: #718096; }
    .trust-search button {
      background: #E1306C;
      color: #fff;
      border: none;
      border-radius: 7px;
      padding: 8px 18px;
      font-size: .85rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      font-family: inherit;
      transition: background .2s;
    }
    .trust-search button:hover { background: #c2185b; }

    /* ---- PILLS ---- */
    .trust-cats {
      display: flex;
      flex-wrap: nowrap;
      gap: 8px;
      margin-top: 12px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 4px;
    }
    .trust-cats::-webkit-scrollbar { display: none; }

    .trust-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.12);
      color: #e2e8f0;
      font-size: .82rem;
      font-weight: 500;
      padding: 6px 14px;
      border-radius: 20px;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
      transition: background .18s, border-color .18s, color .18s, transform .15s;
    }
    .trust-pill:hover {
      background: rgba(225,48,108,.18);
      border-color: rgba(225,48,108,.5);
      color: #fff;
      transform: translateY(-1px);
    }
    .pill-icon {
      font-size: .9rem;
      line-height: 1;
    }
    .trust-pill-all {
      background: rgba(225,48,108,.12);
      border-color: rgba(225,48,108,.3);
      color: #f48fb1;
      font-weight: 700;
    }
    .trust-pill-all:hover {
      background: #E1306C;
      border-color: #E1306C;
      color: #fff;
      transform: translateY(-1px);
    }

    @media (min-width: 768px) {
      .trust-banner { padding: 56px 0 48px; }
      .trust-inner { flex-direction: row; align-items: center; justify-content: space-between; gap: 40px; }
      .trust-actions { flex-shrink: 0; width: 100%; max-width: 480px; }
      .trust-cats { flex-wrap: nowrap; overflow-x: visible; }
    }
  </style>
  <!-- =================== /TRUST BANNER =================== -->


  {siloPosts.length > 0 ? (
    <section class="hero" id="heroSection">
      <div class="container">
        <div class="hero-grid">

          <article class="hero-main" id="heroMain" style="opacity:0; transition: opacity 0.45s ease;">
            <a id="heroImgLink" href="#" class="hero-main-img-wrap">
              <img id="heroImg" src="" alt="" class="hero-main-img" width="820" height="547"
                loading="eager" fetchpriority="high" decoding="sync" />
            </a>
            <span id="heroCat" class="hero-cat"></span>
            <h1 class="hero-title"><a id="heroTitleLink" href="#"></a></h1>
            <p id="heroExcerpt" class="hero-excerpt"></p>
            <a id="heroBtn" href="#" class="btn-read-full">
              Ler an&#225;lise completa
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </article>

          <aside class="hero-sidebar">
            <div class="hero-sidebar-header">Outras an&#225;lises</div>
            <div id="sidebarPosts"></div>
          </aside>

        </div>
      </div>
    </section>
  ) : (
    <section class="section section-white">
      <div class="container">
        <div class="empty-state">
          <h2>Em breve: reviews e guias de compra</h2>
          <p>Estamos preparando an&#225;lises completas para voc&#234;.</p>
        </div>
      </div>
    </section>
  )}

  {gridPosts.length > 0 && (
    <section class="section section-gray">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-label">Mais Categorias</span>
            <h2 class="section-title">Explore por assunto</h2>
          </div>
          <a href="/blog" class="section-link">
            Ver todos
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="post-grid">
          {gridPosts.map(post => (
            <article class="post-card">
              <a href={`/blog/${post.slug}`} class="post-card-img-wrap">
                <img src={post.data.image || '/placeholder.webp'} alt={post.data.title}
                  class="post-card-img" width="600" height="400" loading="lazy" />
              </a>
              <div class="post-card-body">
                <span class="post-card-cat">{post.data.category}</span>
                <h3 class="post-card-title"><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
                {post.data.description && <p class="post-card-excerpt">{post.data.description}</p>}
              </div>
              <div class="post-card-footer">
                <time class="post-card-date" datetime={post.data.date?.toISOString?.() ?? ''}>
                  {fmtDate(post.data.date)}
                </time>
                <a href={`/blog/${post.slug}`} class="post-card-read">
                  Ler review
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <div id="postsPool" style="display:none" aria-hidden="true">
    {siloPosts.map((p, i) => (
      <div
        data-idx={i}
        data-slug={p.slug}
        data-title={p.data.title}
        data-desc={p.data.description || ''}
        data-cat={p.data.category || ''}
        data-img={p.data.image || '/placeholder.webp'}
        data-url={`/blog/${p.slug}`}
      ></div>
    ))}
  </div>

  <script>
    const container = document.getElementById('postsPool');
    const items = container ? Array.from(container.children) : [];

    const pool = items.map(el => ({
      slug:  el.dataset.slug,
      title: el.dataset.title,
      desc:  el.dataset.desc,
      cat:   el.dataset.cat,
      img:   el.dataset.img,
      url:   el.dataset.url,
    }));

    if (pool.length === 0) {
      document.getElementById('heroSection')?.remove();
    } else {
      const idx     = Math.floor(Math.random() * pool.length);
      const hero    = pool[idx];
      const sidebar = [...pool.slice(0, idx), ...pool.slice(idx + 1)].slice(0, 4);

      const heroMain    = document.getElementById('heroMain');
      const imgLink     = document.getElementById('heroImgLink');
      const img         = document.getElementById('heroImg');
      const cat         = document.getElementById('heroCat');
      const titleLink   = document.getElementById('heroTitleLink');
      const excerpt     = document.getElementById('heroExcerpt');
      const btn         = document.getElementById('heroBtn');

      imgLink.href          = hero.url;
      img.src               = hero.img;
      img.alt               = hero.title;
      cat.textContent       = hero.cat;
      titleLink.href        = hero.url;
      titleLink.textContent = hero.title;
      excerpt.textContent   = hero.desc;
      btn.href              = hero.url;

      requestAnimationFrame(() => { heroMain.style.opacity = '1'; });

      const sidebarEl = document.getElementById('sidebarPosts');
      sidebar.forEach(post => {
        const a = document.createElement('a');
        a.href = post.url;
        a.className = 'sidebar-post';
        a.innerHTML = `
          <img src="${post.img}" alt="" class="sidebar-post-img" loading="lazy" width="64" height="48" />
          <div>
            <span class="sidebar-post-cat">${post.cat}</span>
            <span class="sidebar-post-title">${post.title}</span>
          </div>`;
        sidebarEl.appendChild(a);
      });
    }
  </script>

</Layout>
