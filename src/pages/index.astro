---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 1. Coleta de dados (Programmatic SEO Prep)
let allPosts = [];
try {
  allPosts = await getCollection('blog');
} catch (e) {
  console.error("Erro ao carregar posts:", e);
}

// 2. Criação de Silos Semânticos (Agrupando por Categoria)
// Pega os posts não-rascunho ordenados por data
const publishedPosts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categories = [...new Set(publishedPosts.map(p => p.data.category || 'Geral'))];

// Pega o último post de cada categoria para a Home
const siloPosts = categories.map(cat => {
  return publishedPosts.find(p => (p.data.category || 'Geral') === cat);
}).filter(Boolean);

// Schema.org para a Home (CollectionPage)
const homeSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "AchadoCerto.VIP | Reviews e Guias de Compra",
  "description": "Guias de compras baseados em testes reais e pesquisa aprofundada.",
  "url": "https://achadocerto.vip/"
});
---

<Layout schema={homeSchema}>
  <!-- HEADER DO PORTAL (Entity-based NLP Focus) -->
  <section style="padding: 80px 0 40px; text-align: center; background: var(--bg-surface); border-bottom: 1px solid var(--border-light);">
    <div class="container">
      <h1 style="font-size: clamp(32px, 5vw, 48px); font-weight: 800; letter-spacing: -1px; color: var(--primary); margin-bottom: 16px;">
        Compre com confiança. <br/>Sem perder tempo.
      </h1>
      <p style="font-size: 18px; color: var(--text-muted); max-width: 600px; margin: 0 auto; line-height: 1.6;">
        Nós pesquisamos, testamos e comparamos centenas de produtos para que você encontre exatamente o que precisa, pelo melhor preço.
      </p>
    </div>
  </section>

  <!-- SILOS DE CONTEÚDO (Último post de cada categoria) -->
  {siloPosts.map((post, index) => {
    // Otimização LCP: Apenas a primeira imagem da primeira categoria recebe fetchpriority="high"
    const isLCP = index === 0;
    
    return (
      <section class="silo-section">
        <div class="container">
          <div class="silo-header">
            <h2 class="silo-title">{post.data.category}</h2>
            <a href={`/categorias/${post.data.category.toLowerCase()}`} class="silo-link">
              Ver todos os guias →
            </a>
          </div>

          <article class="review-card-hero">
            <a href={`/blog/${post.slug}`} class="r-card-img-wrapper" aria-label={`Ler review sobre ${post.data.title}`}>
              <img 
                src={post.data.image || 'https://via.placeholder.com/800x450'} 
                alt={`Imagem do review: ${post.data.title}`} 
                class="r-card-img"
                width="800" 
                height="450"
                loading={isLCP ? "eager" : "lazy"}
                fetchpriority={isLCP ? "high" : "auto"}
                decoding={isLCP ? "sync" : "async"}
              />
            </a>
            <div class="r-card-content">
              <span class="r-card-cat">Novo em {post.data.category}</span>
              <h3 class="r-card-title">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>
              <!-- A resposta SGE/GEO já começa no excerpt do post -->
              <p class="r-card-excerpt">
                {post.data.description}
              </p>
              <a href={`/blog/${post.slug}`} class="btn-primary">
                Ler Análise Completa
              </a>
            </div>
          </article>
        </div>
      </section>
    );
  })}
</Layout>
