---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categorias = [...new Set(posts.map(p => {
    const slug = p.data.category.toLowerCase();
    if (slug === 'lar') return 'casa';
    if (slug === 'esporte') return 'esportes';
    return slug;
  }))];
  return categorias.map(cat => ({
    params: { categoria: cat },
    props: {
      categoria: cat,
      posts: posts
        .filter(p => {
          const s = p.data.category.toLowerCase();
          const mapped = s === 'lar' ? 'casa' : s === 'esporte' ? 'esportes' : s;
          return mapped === cat;
        })
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { categoria, posts } = Astro.props;

const nomes: Record<string, string> = {
  beleza:     'Beleza & Fragrâncias',
  saude:      'Saúde & Suplementos',
  casa:       'Casa & Bem-Estar',
  lar:        'Casa & Bem-Estar',
  tech:       'Tech & Eletrônicos',
  esportes:   'Esportes',
  esporte:    'Esportes',
  dicas:      'Dicas & Guias',
  guias:      'Dicas & Guias',
  automotivo: 'Automotivo',
};

const editorial: Record<string, { intro: string; bullets: string[] }> = {
  beleza: {
    intro: 'Perfumes, colônias e body splash têm o poder de marcar momentos e definir identidades. Aqui você encontra análises honestas e independentes para escolher a fragrância certa — sem cair em marketing vazio ou lançamentos superfaturados.',
    bullets: [
      'Avaliamos duração, projeção e fixidez de cada produto',
      'Comparamos opções premium e custo-benefício',
      'Indicamos onde encontrar cada produto nas principais lojas',
    ],
  },
  saude: {
    intro: 'Suplementos e vitaminas inundam o mercado com promessas exageradas. Nossa curadoria filtra o que realmente funciona: analisamos fórmulas, dosagens, procedência e custo por dose para que você invista com inteligência na sua saúde.',
    bullets: [
      'Verificamos fórmula, dosagem e procedência de cada produto',
      'Comparação entre marcas nacionais e importadas',
      'Foco em custo por dose, não apenas preço de embalagem',
    ],
  },
  casa: {
    intro: 'Eletrodomésticos e utilitários de qualidade transformam a rotina em casa. Avaliamos desempenho real, durabilidade e facilidade de uso para que cada compra traga valor de longo prazo — e não apenas no unboxing.',
    bullets: [
      'Avaliamos desempenho, consumo de energia e facilidade de uso',
      'Comparamos custo-benefício entre marcas e modelos similares',
      'Indicamos onde comprar com melhor preço e menor risco',
    ],
  },
};

const nomeExibido = nomes[categoria] ?? categoria.charAt(0).toUpperCase() + categoria.slice(1);
const ed = editorial[categoria] ?? null;

function fmtDate(d: Date | undefined) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}

const siteUrl = 'https://achadocerto.vip';
const pageUrl = `${siteUrl}/categorias/${categoria}`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${nomeExibido} — Reviews | AchadoCertoVIP`,
  description: ed?.intro ?? `Reviews e guias de compra de ${nomeExibido}.`,
  url: pageUrl,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.slice(0, 10).map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${siteUrl}/blog/${post.slug}`,
      name: post.data.title,
    })),
  },
};
---

<Layout
  title={`${nomeExibido} — Reviews e Guias | AchadoCerto`}
  description={ed?.intro ?? `Os melhores reviews e guias de compra de ${nomeExibido} do Brasil. Análises independentes e honestas.`}
  schema={collectionSchema}
>

  <section class="cat-hero">
    <div class="container">
      <nav class="cat-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Início</a>
        <span aria-hidden="true">›</span>
        <span>{nomeExibido}</span>
      </nav>

      <div class="cat-hero-inner">
        <div class="cat-hero-text">
          <h1 class="cat-hero-title">{nomeExibido}</h1>
          <p class="cat-hero-count">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            {posts.length} {posts.length === 1 ? 'review publicado' : 'reviews publicados'}
          </p>
          {ed && <p class="cat-hero-intro">{ed.intro}</p>}
        </div>

        {ed && (
          <ul class="cat-hero-bullets">
            {ed.bullets.map(b => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                {b}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  <section class="cat-grid-section">
    <div class="container">
      {posts.length === 0 ? (
        <div class="cat-empty">
          <p>Em breve: reviews de {nomeExibido}.</p>
          <a href="/blog">← Ver todos os reviews</a>
        </div>
      ) : (
        <div class="cat-grid">
          {posts.map(post => (
            <article class="cat-card">
              {post.data.image && (
                <a href={`/blog/${post.slug}`} class="cat-card-img-wrap">
                  <img src={post.data.image} alt={post.data.title}
                    class="cat-card-img" loading="lazy" width="400" height="400" />
                </a>
              )}
              <div class="cat-card-body">
                <span class="cat-card-cat">{post.data.category}</span>
                <h2 class="cat-card-title">
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </h2>
                {post.data.description && (
                  <p class="cat-card-desc">{post.data.description}</p>
                )}
                <div class="cat-card-footer">
                  <time class="cat-card-date">{fmtDate(post.data.date)}</time>
                  <a href={`/blog/${post.slug}`} class="cat-card-read">Ler review →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

</Layout>

<style>
  .cat-hero { background:var(--c-surface,#fff); border-bottom:1px solid var(--c-border,#e2e8f0); padding:48px 0 44px; }
  .cat-breadcrumb { display:flex; align-items:center; gap:6px; font-size:.8rem; color:var(--c-text-muted,#718096); margin-bottom:20px; }
  .cat-breadcrumb a { color:var(--c-brand,#E1306C); text-decoration:none; }
  .cat-breadcrumb a:hover { text-decoration:underline; }
  .cat-hero-inner { display:flex; flex-direction:column; gap:28px; }
  @media (min-width:768px) {
    .cat-hero-inner { flex-direction:row; align-items:flex-start; gap:48px; }
    .cat-hero-text { flex:1; }
  }
  .cat-hero-title { font-size:clamp(1.8rem,4vw,2.6rem); font-weight:800; letter-spacing:-.5px; color:var(--c-text,#1a202c); margin:0 0 10px; }
  .cat-hero-count { display:inline-flex; align-items:center; gap:6px; font-size:.82rem; font-weight:600; color:var(--c-text-muted,#718096); background:var(--c-bg,#f8f9fa); border:1px solid var(--c-border,#e2e8f0); padding:4px 12px; border-radius:20px; margin-bottom:18px; }
  .cat-hero-intro { font-size:1rem; color:var(--c-text-sub,#4a5568); line-height:1.7; margin:0; max-width:580px; }
  .cat-hero-bullets { list-style:none; margin:0; padding:20px 24px; display:flex; flex-direction:column; gap:12px; background:var(--c-bg,#f8f9fa); border:1px solid var(--c-border,#e2e8f0); border-left:3px solid var(--c-brand,#E1306C); border-radius:10px; min-width:260px; }
  .cat-hero-bullets li { display:flex; align-items:flex-start; gap:10px; font-size:.88rem; color:var(--c-text-sub,#4a5568); line-height:1.5; }
  .cat-hero-bullets li svg { color:var(--c-brand,#E1306C); flex-shrink:0; margin-top:2px; }
  .cat-grid-section { padding:48px 0 80px; background:var(--c-bg,#f8f9fa); }
  .cat-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:28px; }
  .cat-card { background:var(--c-surface,#fff); border:1px solid var(--c-border,#e2e8f0); border-radius:var(--r-md,12px); overflow:hidden; transition:box-shadow .2s,transform .2s; }
  .cat-card:hover { box-shadow:0 8px 24px rgba(0,0,0,.09); transform:translateY(-2px); }
  .cat-card-img-wrap { display:block; background:#fff; padding:12px; }
  .cat-card-img { width:100%; aspect-ratio:1/1; object-fit:contain; }
  .cat-card-body { padding:20px; }
  .cat-card-cat { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--c-brand,#E1306C); }
  .cat-card-title { font-size:1.05rem; font-weight:700; letter-spacing:-.2px; margin:8px 0; line-height:1.35; }
  .cat-card-title a { color:var(--c-text,#1a202c); text-decoration:none; transition:color .15s; }
  .cat-card-title a:hover { color:var(--c-brand,#E1306C); }
  .cat-card-desc { font-size:.85rem; color:var(--c-text-sub,#4a5568); line-height:1.6; margin-bottom:16px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .cat-card-footer { display:flex; align-items:center; justify-content:space-between; }
  .cat-card-date { font-size:.75rem; color:var(--c-text-muted,#718096); }
  .cat-card-read { font-size:.82rem; font-weight:600; color:var(--c-brand,#E1306C); text-decoration:none; }
  .cat-card-read:hover { text-decoration:underline; }
  .cat-empty { text-align:center; padding:80px 0; color:var(--c-text-muted,#718096); }
  .cat-empty p { font-size:1.1rem; margin-bottom:16px; }
  .cat-empty a { color:var(--c-brand,#E1306C); }
</style>
