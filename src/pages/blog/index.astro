---
import Layout from '../../layouts/Layout.astro';

let posts = [];
try {
  const { getCollection } = await import('astro:content');
  posts = (await getCollection('blog'))
    .filter(p => !p.data.draft)
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
} catch(e) { posts = []; }

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Blog — AchadoCerto',
  description: 'Todos os reviews, comparativos e guias de compra do AchadoCerto.',
  url: 'https://achadocerto.vip/blog',
};
---

<Layout
  title="Reviews e Guias de Compra — AchadoCerto"
  description="Todos os nossos reviews, comparativos e guias de compra independentes."
  schema={schema}
>
  <!-- Page header com campo de busca -->
  <div style="background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding: 48px 0 40px;">
    <div class="container">
      <span class="section-label">Blog</span>
      <h1 class="section-title" style="font-size: clamp(28px, 4vw, 40px); margin-top: 4px;">Reviews &amp; Guias de Compra</h1>
      <p style="font-size: 16px; color: var(--c-text-muted); margin-top: 10px; max-width: 520px;">
        Análises honestas, testes reais e comparativos para você comprar com confiança.
      </p>
      <!-- Campo de busca principal -->
      <div style="display:flex; gap:8px; margin-top:24px; max-width:480px; position:relative;">
        <input
          id="searchInput"
          type="search"
          placeholder="Buscar reviews e guias..."
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          style="flex:1; padding:10px 14px; border:1.5px solid var(--c-border); border-radius:8px; font-size:15px; outline:none;"
        />
        <button onclick="doSearch()" style="padding:10px 18px; background:var(--c-primary); color:#fff; border:none; border-radius:8px; font-weight:600; cursor:pointer; font-size:15px;">
          Buscar
        </button>
      </div>
      <p id="searchStatus" style="margin-top:12px; font-size:14px; color:var(--c-text-muted); min-height:20px;"></p>
    </div>
  </div>

  <section class="section section-white">
    <div class="container">
      <div id="postGrid" class="post-grid">
        {posts.map(post => (
          <article
            class="post-card"
            data-title={post.data.title.toLowerCase()}
            data-description={(post.data.description || '').toLowerCase()}
            data-category={(post.data.category || '').toLowerCase()}
          >
            <a href={`/blog/${post.slug}`} class="post-card-img-wrap">
              <img
                src={post.data.image || '/placeholder.webp'}
                alt={post.data.title}
                class="post-card-img"
                width="600" height="400"
                loading="lazy"
              />
            </a>
            <div class="post-card-body">
              <span class="post-card-cat">{post.data.category}</span>
              <h2 class="post-card-title">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h2>
              {post.data.description && (
                <p class="post-card-excerpt">{post.data.description}</p>
              )}
            </div>
            <div class="post-card-footer">
              <time class="post-card-date" datetime={post.data.date?.toISOString?.() ?? ''}>
                {fmtDate(post.data.date)}
              </time>
              <a href={`/blog/${post.slug}`} class="post-card-read">
                Ler review
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Estado vazio -->
      <div id="emptyState" style="display:none; text-align:center; padding:64px 0;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5" style="margin-bottom:16px;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <h2 style="font-size:20px; color:var(--c-text-muted);">Nenhum resultado encontrado</h2>
        <p style="color:var(--c-text-muted); margin-top:8px;">Tente outras palavras ou <a href="/blog" style="color:var(--c-primary);">veja todos os reviews</a>.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    function initSearch() {
      var input = document.getElementById('searchInput');
      var status = document.getElementById('searchStatus');
      var emptyState = document.getElementById('emptyState');
      var cards = document.querySelectorAll('.post-card');
      if (!input) return;

      function doSearch() {
        var q = input.value.trim().toLowerCase();
        // Atualiza URL sem recarregar
        var url = new URL(window.location.href);
        if (q) { url.searchParams.set('q', q); } else { url.searchParams.delete('q'); }
        history.replaceState(null, '', url);

        var visible = 0;
        cards.forEach(function(card) {
          var match = !q ||
            card.dataset.title.includes(q) ||
            card.dataset.description.includes(q) ||
            card.dataset.category.includes(q);
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });

        if (q) {
          status.textContent = visible === 0
            ? 'Nenhum resultado para "' + input.value.trim() + '"'
            : visible + ' resultado' + (visible !== 1 ? 's' : '') + ' para "' + input.value.trim() + '"';
        } else {
          status.textContent = '';
        }
        emptyState.style.display = visible === 0 ? 'block' : 'none';
      }

      // Expoe globalmente para o botao onclick
      window.doSearch = doSearch;

      // Busca ao digitar (debounce 250ms)
      var timer;
      input.addEventListener('input', function() {
        clearTimeout(timer);
        timer = setTimeout(doSearch, 250);
      });

      // Busca ao pressionar Enter
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { clearTimeout(timer); doSearch(); }
      });

      // Le ?q= da URL, preenche o campo e executa busca
      // SEM chamar input.focus() para não abrir o teclado mobile
      var params = new URLSearchParams(window.location.search);
      var q = params.get('q') || '';
      if (q) {
        input.value = q;
        doSearch();
        // Scroll suave até os resultados após breve delay (aguarda render)
        setTimeout(function() {
          var grid = document.getElementById('postGrid');
          if (grid) {
            grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 120);
      }
    }

    // Compativel com navegacao normal E com Astro View Transitions
    document.addEventListener('DOMContentLoaded', initSearch);
    document.addEventListener('astro:page-load', initSearch);
  </script>
</Layout>
