---
import Layout from '../../layouts/Layout.astro';

let posts = [];
try {
  const { getCollection } = await import('astro:content');
  posts = (await getCollection('blog'))
    .filter(p => !p.data.draft)
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
} catch(e) { posts = []; }

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Blog — AchadoCerto',
  description: 'Todos os reviews, comparativos e guias de compra do AchadoCerto.',
  url: 'https://achadocerto.vip/blog',
};
---

<Layout
  title="Reviews e Guias de Compra — AchadoCerto"
  description="Todos os nossos reviews, comparativos e guias de compra independentes."
  schema={schema}
>
  <!-- Page header -->
  <div style="background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding: 48px 0 40px;">
    <div class="container">
      <span class="section-label">Blog</span>
      <h1 class="section-title" style="font-size: clamp(28px, 4vw, 40px); margin-top: 4px;">Reviews &amp; Guias de Compra</h1>
      <p style="font-size: 16px; color: var(--c-text-muted); margin-top: 10px; max-width: 520px;">
        Análises honestas, testes reais e comparativos para você comprar com confiança.
      </p>
    </div>
  </div>

  <section class="section section-white">
    <div class="container">
      {posts.length === 0 ? (
        <div class="empty-state">
          <h2>Nenhum post publicado ainda</h2>
          <p>Em breve publicaremos reviews completos aqui.</p>
        </div>
      ) : (
        <div class="post-grid">
          {posts.map(post => (
            <article class="post-card">
              <a href={`/blog/${post.slug}`} class="post-card-img-wrap">
                <img
                  src={post.data.image || '/placeholder.webp'}
                  alt={post.data.title}
                  class="post-card-img"
                  width="600" height="400"
                  loading="lazy"
                />
              </a>
              <div class="post-card-body">
                <span class="post-card-cat">{post.data.category}</span>
                <h2 class="post-card-title">
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </h2>
                {post.data.description && (
                  <p class="post-card-excerpt">{post.data.description}</p>
                )}
              </div>
              <div class="post-card-footer">
                <time class="post-card-date" datetime={post.data.date?.toISOString?.() ?? ''}>
                  {fmtDate(post.data.date)}
                </time>
                <a href={`/blog/${post.slug}`} class="post-card-read">
                  Ler review
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
