---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import Footer from '../../components/Footer.astro';

let posts: any[] = [];
try {
  const { getCollection } = await import('astro:content');
  const allPosts = await getCollection('blog');
  posts = allPosts
    .filter(p => !p.data.draft)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
} catch {
  posts = [];
}
---

<Layout
  title="Blog — AchadoCerto.VIP"
  description="Guias de compra, comparativos e dicas de economia curados pelo AchadoCerto.VIP."
>
  <Header />

  <div class="page-header">
    <div class="container">
      <span class="page-header-eyebrow">Blog</span>
      <h1 class="page-header-title">Achados que valem a pena</h1>
      <p class="page-header-sub">Guias, comparativos e promoções selecionadas com critério</p>
    </div>
  </div>

  <section class="section section--white">
    <div class="container">
      {posts.length === 0 ? (
        <div class="empty-state">
          <div class="empty-state-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
          </div>
          <h3>Nenhum post ainda</h3>
          <p>Em breve publicaremos guias e achados incríveis aqui!</p>
          <a href="/" class="btn btn-gold" style="display:inline-flex; margin-top:8px;">Voltar ao Início</a>
        </div>
      ) : (
        <div class="posts-grid">
          {posts.map(post => (
            <PostCard
              title={post.data.title}
              excerpt={post.data.description}
              slug={post.slug}
              category={post.data.category}
              date={post.data.date?.toISOString()}
              image={post.data.image}
              variant="grid"
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <Footer />
</Layout>
