              </a>
              <a href={emailUrl} aria-label="E-mail" class="share-btn share-email" title="Enviar por e-mail">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              </a>
              <button id="share-native-sidebar" aria-label="Mais opções" class="share-btn share-native" title="Mais opções" style="display:none;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
              </button>
            </div>
          </div>

          <div style="margin-bottom:16px;">
            <p style="font-size:10px;text-align:center;color:var(--c-text-light);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase;">Publicidade</p>
            <AdSense slot="7473925904" format="auto" maxWidth="280px" minHeight="250px" />
          </div>

          <div style="background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-md);padding:20px;box-shadow:var(--shadow-sm);">
            <p style="font-size:12px;font-weight:700;text-transform:uppercase;color:var(--c-text-muted);margin-bottom:14px;">Navegar</p>
            <a href="/blog" style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--c-text-sub);padding:8px 0;border-bottom:1px solid var(--c-border);transition:color .2s;"
               onmouseover="this.style.color='var(--c-brand)'" onmouseout="this.style.color='var(--c-text-sub)'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
              Todos os reviews
            </a>
            <a href="/" style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--c-text-sub);padding:8px 0;transition:color .2s;"
               onmouseover="this.style.color='var(--c-brand)'" onmouseout="this.style.color='var(--c-text-sub)'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              Página inicial
            </a>
          </div>
        </aside>
      </div>
    </div>

    <!-- ARTIGOS RELACIONADOS -->
    {relatedPosts.length > 0 && (
      <section class="related-section">
        <div class="container">
          <div class="related-header">
            <div class="related-header-titles">
              <span class="related-eyebrow">Continue lendo</span>
              <h2 class="related-heading">Artigos Relacionados</h2>
            </div>
            <a href={`/categorias/${catSlug}`} class="related-see-all">
              Ver todos em {post.data.category}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
          <div class="related-grid">
            {relatedDisplay.map(related => {
              const isPlaceholder = related.placeholder;
              const relImg = isPlaceholder ? related.image : (related.data?.productImage || related.data?.image || '/og-default.jpg');
              const relUrl = isPlaceholder ? related.slug : `/blog/${related.slug}`;
              const relTitle = isPlaceholder ? related.title : related.data?.title;
              const relDesc = isPlaceholder ? related.description : related.data?.description;
              const relCat = isPlaceholder ? related.category : related.data?.category;
              return (
                <a href={relUrl} class="related-card">
                  <div class="related-img-wrap">
                    <img src={relImg} alt={relTitle} class="related-img" loading="lazy" width="400" height="250" />
                  </div>
                  <div class="related-body">
                    <span class="related-cat">{relCat}</span>
                    <h3 class="related-title">{relTitle}</h3>
                    {relDesc && <p class="related-desc">{relDesc}</p>}
                    <span class="related-cta">
                      {isPlaceholder ? 'Explorar' : 'Ler review'}
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ONDE COMPRAR COM SEGURANÇA -->
    <div style="background:var(--c-surface);padding:40px 0;border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border);">
      <div class="container post-narrow">
        <h2 style="font-size:clamp(18px,2.5vw,22px);font-weight:800;margin:0 0 8px;color:var(--c-text);">🛡️ Onde Comprar com Segurança</h2>
        <p style="font-size:clamp(13px,1.5vw,14px);color:var(--c-text-sub);margin:0 0 20px;line-height:1.6;">
          Dicas específicas para comprar {detectStore(post.data.affiliateUrl) === 'melhor preço' ? 'online' : `no ${detectStore(post.data.affiliateUrl)}`} com tranquilidade
        </p>
        <div style="display:grid;gap:12px;">
          <div style="background:#fff;border:1px solid var(--c-border);border-left:4px solid var(--c-brand);border-radius:var(--r-md);padding:16px 20px;">
            <div style="display:flex;align-items:start;gap:12px;">
              <div style="background:var(--c-brand-soft);color:var(--c-brand);width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;">⭐</div>
              <div style="flex:1;">
                <h3 style="font-size:clamp(14px,1.8vw,15px);font-weight:700;color:var(--c-text);margin:0 0 6px;">Verifique a reputação do vendedor</h3>
                <p style="font-size:clamp(13px,1.5vw,14px);color:var(--c-text-sub);line-height:1.6;margin:0;">
                  {detectStore(post.data.affiliateUrl) === 'Mercado Livre' && 'Procure vendedores com selo MercadoLíder Platinum e mais de 95% de avaliações positivas.'}
                  {detectStore(post.data.affiliateUrl) === 'Amazon' && 'Prefira produtos vendidos e entregues pela Amazon ou vendedores com avaliação acima de 4.5 estrelas.'}
                  {detectStore(post.data.affiliateUrl) === 'Magalu' && 'Verifique a nota do vendedor (acima de 4 estrelas). Vendedores oficiais têm o selo "Vendido e entregue por Magazine Luiza".'}
                  {!['Mercado Livre', 'Amazon', 'Magalu'].includes(detectStore(post.data.affiliateUrl)) && 'Busque vendedores com alta reputação, milhares de vendas e tempo significativo de cadastro na plataforma.'}
                </p>
              </div>
            </div>
          </div>
          <div style="background:#fff;border:1px solid var(--c-border);border-left:4px solid var(--c-brand);border-radius:var(--r-md);padding:16px 20px;">
            <div style="display:flex;align-items:start;gap:12px;">
              <div style="background:var(--c-brand-soft);color:var(--c-brand);width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;">↩️</div>
              <div style="flex:1;">
                <h3 style="font-size:clamp(14px,1.8vw,15px);font-weight:700;color:var(--c-text);margin:0 0 6px;">Leia a política de devolução</h3>
                <p style="font-size:clamp(13px,1.5vw,14px);color:var(--c-text-sub);line-height:1.6;margin:0;">Você tem 7 dias para desistir da compra (CDC). Verifique se há "troca grátis" ou se você arcará com o frete de retorno antes de finalizar.</p>
              </div>
            </div>
          </div>
          <div style="background:#fff;border:1px solid var(--c-border);border-left:4px solid var(--c-brand);border-radius:var(--r-md);padding:16px 20px;">
            <div style="display:flex;align-items:start;gap:12px;">
              <div style="background:var(--c-brand-soft);color:var(--c-brand);width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;">💳</div>
              <div style="flex:1;">
                <h3 style="font-size:clamp(14px,1.8vw,15px);font-weight:700;color:var(--c-text);margin:0 0 6px;">Use pagamento dentro da plataforma</h3>
                <p style="font-size:clamp(13px,1.5vw,14px);color:var(--c-text-sub);line-height:1.6;margin:0;">
                  {detectStore(post.data.affiliateUrl) === 'Mercado Livre' && 'Sempre pague via Mercado Pago para ter proteção na compra.'}
                  {detectStore(post.data.affiliateUrl) === 'Amazon' && 'Pague via sistema da Amazon para ter cobertura da Garantia A-Z.'}
                  {detectStore(post.data.affiliateUrl) === 'Magalu' && 'Use o sistema de pagamento do Magalu — cartão de crédito oferece chargeback em caso de problemas.'}
                  {!['Mercado Livre', 'Amazon', 'Magalu'].includes(detectStore(post.data.affiliateUrl)) && 'Sempre pague pelo sistema oficial da plataforma. Cartão de crédito oferece proteção extra com possibilidade de contestação.'}
                </p>
              </div>
            </div>
          </div>
          <div style="background:linear-gradient(135deg,#f0f4ff,#e8f0fe);border:1px solid var(--c-brand);border-radius:var(--r-md);padding:16px;text-align:center;margin-top:8px;">
            <p style="font-size:13px;color:var(--c-text-sub);margin:0 0 10px;">Mais dúvidas sobre compras online?</p>
            <a href="/faq" class="btn-cta-primary">
              Ver Perguntas Frequentes
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Web Share API -->
  <script>
    (function() {
      const shareData = {
        title: document.title,
        url: window.location.href,
      };
      if (navigator.share) {
        ['share-native-hero', 'share-native-sidebar'].forEach(function(id) {
          const btn = document.getElementById(id);
          if (btn) {
            btn.style.display = 'flex';
            btn.addEventListener('click', function() {
              navigator.share(shareData).catch(function() {});
            });
          }
        });
      }
    })();
  </script>

  <style>
    .post-narrow {
      max-width: 820px;
      margin: 0 auto;
      width: 100%;
    }

    .post-content-grid {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 48px;
      align-items: start;
      max-width: 1100px;
      margin: 0 auto;
      width: 100%;
    }
    .post-sidebar { position: sticky; top: 88px; }

    @media (max-width: 768px) {
      .post-narrow {
        max-width: 100% !important;
        width: 100%;
        overflow-x: hidden;
      }
      .post-content-grid {
        display: block !important;
        max-width: 100% !important;
        overflow-x: hidden;
      }
      .post-sidebar { position:static; margin-top:40px; }
      .share-buttons { width:100%; justify-content:flex-start; margin-top:12px; }
      .product-box-final { padding:24px 16px; }
      .related-grid { grid-template-columns:1fr !important; gap:16px !important; }
      .related-header { flex-direction:column !important; align-items:flex-start !important; gap:10px !important; }
      .related-header-titles { text-align:left !important; }
      .related-eyebrow { text-align:left !important; }
      .related-heading { text-align:left !important; }
      .related-see-all { align-self:flex-start !important; }
      .related-img-wrap { height:160px !important; padding:16px !important; }
      .related-title { font-size:15px !important; -webkit-line-clamp:3 !important; }
      .related-desc { display:none !important; }

      .prose ul,
      .prose ol {
        margin-left: 1.5rem;
        padding-left: 0.25rem;
      }
    }

    @media (min-width: 480px) and (max-width: 768px) {
      .related-grid { grid-template-columns:repeat(2,1fr) !important; }
    }

    .product-box-final {
      display: flex; flex-direction: column; align-items: center; text-align: center;
      background: linear-gradient(135deg, #f0f4ff 0%, #e8f0fe 100%);
      border: 2px solid var(--c-brand); border-radius: var(--r-lg);
      padding: 32px 28px; margin: 48px 0 0;
      box-shadow: 0 6px 28px rgba(26,86,219,.12);
    }
    .product-box-final-img { width:140px;height:140px;object-fit:contain;border-radius:var(--r-md);background:#fff;border:1px solid var(--c-border);padding:8px;margin-bottom:16px; }
    .product-box-final-body { width: 100%; }
    .product-box-final-label { font-size:13px;font-weight:700;color:var(--c-brand);margin-bottom:6px; }
    .product-box-final-name  { font-size:clamp(17px,2.5vw,20px);font-weight:800;color:var(--c-text) !important;margin-bottom:8px;line-height:1.3; }
    .product-box-final-price { font-size:clamp(22px,3.5vw,28px);font-weight:800;color:var(--c-brand);margin-bottom:16px; }

    .product-box-sidebar { background:var(--c-surface);border:1px solid var(--c-border);border-top:3px solid var(--c-brand);border-radius:var(--r-md);overflow:hidden;margin-bottom:16px;box-shadow:var(--shadow-sm); }
    .product-box-sidebar-img-wrap { width:100%;aspect-ratio:1/1;background:#fff;display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--c-border);padding:16px; }
    .product-box-sidebar-img { width:100%;height:100%;object-fit:contain; }
    .product-box-sidebar-body { padding:16px; }
    .product-box-sidebar-label { font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--c-text-muted);margin-bottom:4px; }
    .product-box-sidebar-name  { font-size:14px;font-weight:700;color:var(--c-text);margin-bottom:8px;line-height:1.4; }
    .product-box-sidebar-price { font-size:20px;font-weight:800;color:var(--c-brand);margin-bottom:12px; }
    .product-box-sidebar-disclaimer { font-size:10px;color:var(--c-text-light);text-align:center;margin-top:8px; }

    /* ── SHARE BUTTONS ── */
    .share-buttons {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .share-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--c-text-muted);
      white-space: nowrap;
    }
    .sidebar-share-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .share-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      transition: transform .2s, opacity .2s, box-shadow .2s;
      flex-shrink: 0;
      border: none;
      cursor: pointer;
      text-decoration: none;
    }
    .share-btn:hover {
      transform: scale(1.12);
      opacity: .92;
      box-shadow: 0 4px 12px rgba(0,0,0,.18);
    }
    .share-btn:active { transform: scale(.96); }

    /* Cores oficiais de cada rede */
    .share-facebook  { background: #1877F2; }
    .share-x         { background: #000; }
    .share-whatsapp  { background: #25D366; }
    .share-telegram  { background: #26A5E4; }
    .share-email     { background: #EA4335; }
    .share-native    { background: #6B7280; }

    /* ── PROSE ── */
    .prose {
      color: var(--c-text);
      font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
      line-height: 1.8;
    }
    .prose h2 {
      font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.625rem);
      font-weight: 800;
      letter-spacing: -.4px;
      margin: 40px 0 16px;
      color: var(--c-text);
    }
    .prose h3 {
      font-size: clamp(1.125rem, 1rem + 0.6vw, 1.25rem);
      font-weight: 700;
      margin: 32px 0 12px;
      color: var(--c-text);
    }
    .prose p  { margin-bottom: 20px; }
    .prose a  { color: var(--c-brand); text-decoration: underline; }
    .prose a:hover { color: var(--c-brand-dark); }
    .prose ul, .prose ol { margin: 0 0 20px 1.75rem; }
    .prose li { margin-bottom: 8px; }
    .prose blockquote {
      border-left: 3px solid var(--c-brand);
      padding: 12px 20px;
      background: var(--c-brand-soft);
      border-radius: 0 var(--r-sm) var(--r-sm) 0;
      margin: 24px 0;
      font-style: italic;
      color: var(--c-text-sub);
    }
    .prose img { border-radius: var(--r-md); margin: 24px 0; box-shadow: var(--shadow-md); }
    .prose code { background: var(--c-bg); padding: 2px 6px; border-radius: 4px; font-size: 0.875em; }
    .prose strong { font-weight: 700; color: var(--c-text); }
    .prose hr { border: none; border-top: 1px solid var(--c-border); margin: 40px 0; }
    .prose table { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 0.9em; }
    .prose th { background: var(--c-bg); padding: 10px 14px; text-align: left; font-weight: 700; border: 1px solid var(--c-border); }
    .prose td { padding: 10px 14px; border: 1px solid var(--c-border); }
    .prose tr:nth-child(even) td { background: var(--c-bg); }

    /* ── ARTIGOS RELACIONADOS ── */
    .related-section { background:var(--c-surface);border-top:1px solid var(--c-border);padding:48px 0 56px; }

    .related-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 28px;
      gap: 16px;
    }
    .related-header-titles {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .related-eyebrow {
      display: block;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .9px;
      color: var(--c-brand);
      margin-bottom: 4px;
      text-align: left;
    }
    .related-heading {
      font-size: clamp(20px,3vw,26px);
      font-weight: 800;
      letter-spacing: -.4px;
      color: var(--c-text);
      margin: 0;
      text-align: left;
    }
    .related-see-all {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--c-brand);
      white-space: nowrap;
      transition: gap .18s;
      flex-shrink: 0;
    }
    .related-see-all:hover { gap:9px; text-decoration:underline; }

    .related-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:24px; }

    .related-card {
      display:flex;flex-direction:column;
      background:#fff;
      border:1px solid var(--c-border);
      border-radius:var(--r-md);
      overflow:hidden;
      text-decoration:none;
      box-shadow:var(--shadow-sm);
      transition:transform .2s,box-shadow .2s,border-color .2s;
    }
    .related-card:hover { transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--c-brand); }

    .related-img-wrap {
      width:100%;
      height:180px;
      background:#f8f9fa;
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      border-bottom:1px solid var(--c-border);
      padding:20px;
      flex-shrink:0;
    }
    .related-img {
      max-width:100%;
      max-height:100%;
      width:auto;
      height:auto;
      object-fit:contain;
      transition:transform .35s;
    }
    .related-card:hover .related-img { transform:scale(1.05); }

    .related-body { padding:16px 18px 20px;display:flex;flex-direction:column;gap:6px;flex:1; }
    .related-cat { font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--c-brand); }
    .related-title {
      font-size:15px;
      font-weight:700;
      line-height:1.4;
      color:var(--c-text);
      margin:0;
      display:-webkit-box;
      -webkit-line-clamp:3;
      -webkit-box-orient:vertical;
      overflow:hidden;
    }
    .related-desc {
      font-size:13px;
      color:var(--c-text-muted);
      line-height:1.55;
      margin:0;
      flex:1;
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
    }
    .related-cta {
      display:inline-flex;
      align-items:center;
      gap:5px;
      font-size:13px;
      font-weight:600;
      color:var(--c-brand);
      margin-top:8px;
      transition:gap .18s;
    }
    .related-card:hover .related-cta { gap:9px; }
  </style>
</Layout>
