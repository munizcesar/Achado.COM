---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
}

// Schema Article + Review para SEO/GEO
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description ?? '',
  image: post.data.image ?? '',
  datePublished: post.data.date?.toISOString() ?? '',
  author: { '@type': 'Organization', name: 'AchadoCerto', url: 'https://achadocerto.vip' },
  publisher: { '@type': 'Organization', name: 'AchadoCerto', url: 'https://achadocerto.vip' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://achadocerto.vip/blog/${post.slug}` },
};
---

<Layout
  title={`${post.data.title} — AchadoCerto`}
  description={post.data.description}
  image={post.data.image}
  schema={articleSchema}
>
  <article>
    <!-- HERO DO POST -->
    <div style="background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding: 48px 0 0;">
      <div class="container" style="max-width: 820px;">

        <!-- Breadcrumb -->
        <nav style="font-size: 13px; color: var(--c-text-muted); margin-bottom: 20px; display: flex; gap: 6px; align-items: center;">
          <a href="/" style="color: var(--c-brand);">Início</a>
          <span>›</span>
          <a href="/blog" style="color: var(--c-brand);">Reviews</a>
          <span>›</span>
          {post.data.category && <a href={`/categorias/${post.data.category.toLowerCase()}`} style="color: var(--c-brand);">{post.data.category}</a>}
          {post.data.category && <span>›</span>}
          <span style="color: var(--c-text-light); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px;">{post.data.title}</span>
        </nav>

        <!-- Categoria + Título -->
        <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: var(--c-brand); display: block; margin-bottom: 10px;">
          {post.data.category}
        </span>
        <h1 style="font-size: clamp(26px, 4vw, 42px); font-weight: 800; letter-spacing: -.8px; line-height: 1.2; color: var(--c-text); margin-bottom: 16px;">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p style="font-size: 18px; color: var(--c-text-sub); line-height: 1.7; margin-bottom: 24px; max-width: 680px;">
            {post.data.description}
          </p>
        )}

        <!-- Meta -->
        <div style="display: flex; align-items: center; gap: 16px; font-size: 13px; color: var(--c-text-muted); padding-bottom: 32px; flex-wrap: wrap;">
          <span style="display:flex; align-items:center; gap:5px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <time datetime={post.data.date?.toISOString?.() ?? ''}>{fmtDate(post.data.date)}</time>
          </span>
          <span style="display:flex; align-items:center; gap:5px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Equipe AchadoCerto
          </span>
          {post.data.tags?.length > 0 && post.data.tags.slice(0,3).map(tag => (
            <span style="background: var(--c-tag-bg); color: var(--c-tag-text); padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- IMAGEM DESTAQUE -->
    {post.data.image && (
      <div style="background: var(--c-bg); padding: 0 0 40px;">
        <div class="container" style="max-width: 820px;">
          <img
            src={post.data.image}
            alt={post.data.title}
            style="width:100%; aspect-ratio:16/9; object-fit:cover; border-radius: var(--r-lg); box-shadow: var(--shadow-md); margin-top: -1px;"
            width="820" height="461"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )}

    <!-- CONTEÚDO DO POST -->
    <div style="padding: 8px 0 80px; background: var(--c-bg);">
      <div class="container" style="max-width: 820px; display: grid; grid-template-columns: 1fr 280px; gap: 48px; align-items: start;">

        <!-- Texto principal -->
        <div class="prose">
          <Content />
        </div>

        <!-- Sidebar sticky -->
        <aside style="position: sticky; top: 88px;">
          <!-- Box CTA Afiliado -->
          {post.data.affiliateUrl && (
            <div style="background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--r-md); padding: 20px; margin-bottom: 20px; box-shadow: var(--shadow-sm);">
              <p style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--c-text-muted); margin-bottom: 8px;">Melhor preço encontrado</p>
              <a
                href={post.data.affiliateUrl}
                target="_blank"
                rel="noopener noreferrer sponsored"
                data-affiliate
                data-product={post.data.title}
                data-category={post.data.category}
                style="display:flex; align-items:center; justify-content:center; gap:8px; background: var(--c-brand); color:#fff; font-weight:700; font-size:15px; padding: 13px 20px; border-radius: var(--r-sm); transition: background .2s;"
                onmouseover="this.style.background='var(--c-brand-dark)'"
                onmouseout="this.style.background='var(--c-brand)'"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Ver melhor preço
              </a>
              <p style="font-size: 11px; color: var(--c-text-light); text-align:center; margin-top: 8px;">Link de afiliado — sem custo extra para você</p>
            </div>
          )}

          <!-- Navegação -->
          <div style="background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--r-md); padding: 20px; box-shadow: var(--shadow-sm);">
            <p style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--c-text-muted); margin-bottom: 14px;">Navegar</p>
            <a href="/blog" style="display:flex; align-items:center; gap:8px; font-size:14px; color: var(--c-text-sub); padding: 8px 0; border-bottom: 1px solid var(--c-border); transition: color .2s;"
               onmouseover="this.style.color='var(--c-brand)'" onmouseout="this.style.color='var(--c-text-sub)'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
              Todos os reviews
            </a>
            <a href="/" style="display:flex; align-items:center; gap:8px; font-size:14px; color: var(--c-text-sub); padding: 8px 0; transition: color .2s;"
               onmouseover="this.style.color='var(--c-brand)'" onmouseout="this.style.color='var(--c-text-sub)'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              Página inicial
            </a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <!-- ESTILOS DO PROSE (conteúdo markdown) -->
  <style>
    .prose { color: var(--c-text); font-size: 17px; line-height: 1.8; }
    .prose h2 { font-size: 26px; font-weight: 800; letter-spacing: -.4px; margin: 40px 0 16px; color: var(--c-text); }
    .prose h3 { font-size: 20px; font-weight: 700; margin: 32px 0 12px; color: var(--c-text); }
    .prose p  { margin-bottom: 20px; }
    .prose a  { color: var(--c-brand); text-decoration: underline; }
    .prose a:hover { color: var(--c-brand-dark); }
    .prose ul, .prose ol { margin: 0 0 20px 24px; }
    .prose li { margin-bottom: 8px; }
    .prose blockquote { border-left: 3px solid var(--c-brand); padding: 12px 20px; background: var(--c-brand-soft); border-radius: 0 var(--r-sm) var(--r-sm) 0; margin: 24px 0; font-style: italic; color: var(--c-text-sub); }
    .prose img { border-radius: var(--r-md); margin: 24px 0; box-shadow: var(--shadow-md); }
    .prose code { background: var(--c-bg); padding: 2px 6px; border-radius: 4px; font-size: 14px; }
    .prose strong { font-weight: 700; color: var(--c-text); }
    .prose hr { border: none; border-top: 1px solid var(--c-border); margin: 40px 0; }
    .prose table { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 15px; }
    .prose th { background: var(--c-bg); padding: 10px 14px; text-align: left; font-weight: 700; border: 1px solid var(--c-border); }
    .prose td { padding: 10px 14px; border: 1px solid var(--c-border); }
    .prose tr:nth-child(even) td { background: var(--c-bg); }
    @media (max-width: 768px) {
      .container[style*='grid-template-columns'] { display: block !important; }
    }
  </style>
</Layout>
