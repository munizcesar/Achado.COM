---
import Layout from '../../layouts/Layout.astro';
import AdSense from '../../components/AdSense.astro';
import ChannelBanner from '../../components/ChannelBanner.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
}

function normalizeCategory(cat) {
  if (!cat) return '';
  return cat.toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .trim();
}

function mapCategory(cat) {
  const normalized = normalizeCategory(cat);
  if (normalized === 'lar') return 'casa';
  if (normalized === 'esporte') return 'esportes';
  if (normalized === 'guias') return 'dicas';
  return normalized;
}

const siteUrl = 'https://achadocerto.vip';
const postUrl = `${siteUrl}/blog/${post.slug}`;
const ogImage = post.data.image
  ? (post.data.image.startsWith('http') ? post.data.image : `${siteUrl}${post.data.image}`)
  : `${siteUrl}/og-default.jpg`;

const productImage = post.data.productImage || post.data.image || null;
const hasAffiliate  = !!post.data.affiliateUrl;
const hasAffiliateEn = !!post.data.affiliateUrlEn;
const price         = post.data.price || null;
const categorySlug  = mapCategory(post.data.category);

const articleAuthor = post.data.author || 'Equipe AchadoCerto';
const articleDate   = post.data.date?.toISOString() ?? '';

const amazonUsUrl = post.data.affiliateUrlEn || `https://www.amazon.com/s?k=${encodeURIComponent(post.data.title)}&tag=achadocertovip-20`;

function detectStore(url) {
  if (!url) return 'melhor preço';
  const urlLower = url.toLowerCase();
  if (urlLower.includes('mercadolivre.com') || urlLower.includes('meli.la')) return 'Mercado Livre';
  if (urlLower.includes('amazon.com')) return 'Amazon';
  if (urlLower.includes('magalu.com') || urlLower.includes('magazineluiza')) return 'Magalu';
  return 'melhor preço';
}
const storeName = detectStore(post.data.affiliateUrl);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description ?? '',
  image: ogImage,
  datePublished: articleDate,
  author: { '@type': 'Organization', name: 'AchadoCerto', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'AchadoCerto', url: siteUrl },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: post.data.category, item: `${siteUrl}/categorias/${categorySlug}` },
    { '@type': 'ListItem', position: 4, name: post.data.title, item: postUrl }
  ]
};

const encodedTitle = encodeURIComponent(`${post.data.title} — AchadoCerto`);
const encodedUrl   = encodeURIComponent(postUrl);
const twitterUrl   = `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const facebookUrl  = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;

const allPosts = await getCollection('blog');
function shuffleArray(arr) {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

const relatedByCategory = shuffleArray(
  allPosts.filter(p => p.slug !== post.slug && p.data.category === post.data.category)
);

const others = shuffleArray(
  allPosts.filter(p => p.slug !== post.slug && p.data.category !== post.data.category)
);

const relatedPosts = (relatedByCategory.length >= 3
  ? relatedByCategory
  : [...relatedByCategory, ...others]
).slice(0, 3);

const relatedPlaceholders = Array.from({ length: Math.max(0, 3 - relatedPosts.length) }, () => ({
  placeholder: true,
  title: 'Ver mais artigos',
  description: 'Explore mais reviews e guias no blog.',
  category: 'Explorar',
  slug: '/blog',
  image: '/og-default.jpg',
}));

const relatedDisplay = [...relatedPosts, ...relatedPlaceholders];
---

<Layout
  title={`${post.data.title} — AchadoCerto`}
  description={post.data.description}
  image={ogImage}
  schema={[articleSchema, breadcrumbSchema]}
  isArticle={true}
  articleDate={articleDate}
  articleAuthor={articleAuthor}
>
  <article>

    <div style="background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding: 12px 0 0;" >
      <div class="container" style="max-width: 1100px;">
        <nav style="font-size:13px;color:var(--c-text-muted);margin-bottom:20px;display:flex;gap:6px;align-items:center;flex-wrap:nowrap;overflow:hidden;">
          <a href="/" style="color:var(--c-brand);white-space:nowrap;">Início</a><span style="flex-shrink:0;">›</span>
          <a href="/blog" style="color:var(--c-brand);white-space:nowrap;">Reviews</a><span style="flex-shrink:0;">›</span>
          {post.data.category && <a href={`/categorias/${categorySlug}`} style="color:var(--c-brand);white-space:nowrap;">{post.data.category}</a>}
          {post.data.category && <span style="flex-shrink:0;">›</span>}
          <span style="color:var(--c-text-light);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">{post.data.title}</span>
        </nav>

        <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--c-brand);display:block;margin-bottom:10px;">
          {post.data.category}
        </span>
        <h1 style="font-size:clamp(26px,4vw,42px);font-weight:800;letter-spacing:-.8px;line-height:1.2;color:var(--c-text);margin-bottom:16px;">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p style="font-size:18px;color:var(--c-text-sub);line-height:1.7;margin-bottom:24px;max-width:680px;">
            {post.data.description}
          </p>
        )}

        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:32px;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:16px;font-size:13px;color:var(--c-text-muted);flex-wrap:wrap;">
            <span style="display:flex;align-items:center;gap:5px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <time datetime={articleDate}>{fmtDate(post.data.date)}</time>
            </span>
            <span style="display:flex;align-items:center;gap:5px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              {articleAuthor}
            </span>
            {post.data.tags?.length > 0 && post.data.tags.slice(0,3).map(tag => (
              <span style="background:var(--c-tag-bg);color:var(--c-tag-text);padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;">#{tag}</span>
            ))}
          </div>

          <div class="share-bar">
            <div class="share-bar-btns">
<a href={twitterUrl} target="_blank" rel="noopener noreferrer" aria-label="X / Twitter" class="sicon sicon-x">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="sicon sicon-fb">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
<button class="sicon sicon-copy" id="share-copy-hdr" aria-label="Copiar link">
                <svg id="icon-copy-hdr" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                <svg id="icon-check-hdr" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
              <button class="sicon sicon-native" id="share-native-hdr" aria-label="Compartilhar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    {post.data.image && (
      <div style="background:var(--c-bg);padding:0 0 40px;">
        <div class="container" style="max-width:1100px;">
          <picture>
            <source srcset={post.data.image} type="image/webp" />
            <img
              src={post.data.image}
              alt={post.data.title}
              style="width:100%;height:auto;max-height:500px;object-fit:contain;object-position:center;border-radius:var(--r-lg);box-shadow:var(--shadow-md);margin-top:-1px;background:#fff;"
              width="1100" height="619"
              loading="eager"
              fetchpriority="high"
              onerror="this.style.display='none';"
            />
          </picture>
        </div>
      </div>
    )}

    <div style="padding:32px 0 80px;background:var(--c-bg);">
      <div class="container post-content-grid" style="max-width:1100px;">

        <div class="prose">
          <Content />

          <div class="ads-mid-article">
            <AdSense slot="7473925904" format="fluid" maxWidth="680px" label={true} />
          </div>

          {hasAffiliate && (
            <details class="amazon-us-disclosure amazon-br-disclosure">
              <summary class="amazon-us-summary amazon-br-summary">
                <span class="amazon-us-summary-copy">
                  <span class="amazon-us-summary-eyebrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="margin-right:2px;position:relative;top:2px"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg> Brasil</span>
                  <span class="amazon-us-summary-title">Ver no {storeName}</span>
                </span>
                <span class="amazon-us-summary-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="product-box-final">
                {productImage && (
                  <img
                    src={productImage}
                    alt={post.data.title}
                    class="product-box-final-img"
                    loading="lazy"
                  />
                )}
                <div class="product-box-final-body">
                  <p class="product-box-final-label">⭐ Gostou do review? Confira o preço agora</p>
                  <p class="product-box-final-name">{post.data.title}</p>
                  {price && <p class="product-box-final-price">{price}</p>}
                  <a
                    href={post.data.affiliateUrl}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                    data-affiliate
                    data-product={post.data.title}
                    data-category={post.data.category}
                    class="product-box-final-btn"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    Ver no {storeName}
                  </a>
                  <p style="font-size:11px;color:var(--c-text-light);text-align:center;margin-top:8px;">Link de afiliado — sem custo extra para você</p>
                </div>
              </div>
            </details>
          )}

          <details class="amazon-us-disclosure">
            <summary class="amazon-us-summary">
              <span class="amazon-us-summary-copy">
                <span class="amazon-us-summary-eyebrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="margin-right:2px;position:relative;top:2px"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> US / International</span>
                <span class="amazon-us-summary-title">Shop on Amazon.com</span>
              </span>
              <span class="amazon-us-summary-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="amazon-us-banner">
              <div class="amazon-us-flag">
                <svg width="40" height="27" viewBox="0 0 40 27" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="40" height="27" rx="3" fill="#B22234"/>
                  <rect y="2" width="40" height="2.08" fill="white"/>
                  <rect y="6.15" width="40" height="2.08" fill="white"/>
                  <rect y="10.31" width="40" height="2.08" fill="white"/>
                  <rect y="14.46" width="40" height="2.08" fill="white"/>
                  <rect y="18.62" width="40" height="2.08" fill="white"/>
                  <rect y="22.77" width="40" height="2.08" fill="white"/>
                  <rect width="16" height="14.5" rx="0" fill="#3C3B6E"/>
                </svg>
              </div>
              <div class="amazon-us-body">
                <p class="amazon-us-label">US & International Visitors</p>
                <p class="amazon-us-title">Shop equivalent or similar products on <strong>Amazon.com</strong></p>
                <p class="amazon-us-sub">Fast US shipping · Pay in USD · Free returns on millions of items</p>
              </div>
              <a
                href={amazonUsUrl}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="amazon-us-btn"
                data-affiliate
                data-product={post.data.title}
                data-category="amazon-us"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M21.5 11.5c-1.2-4.4-5.2-7.5-9.5-7.5-5.8 0-10.5 4.7-10.5 10.5s4.7 10.5 10.5 10.5c4.4 0 8.3-2.8 9.9-7H19c-1.4 2.9-4.4 5-7.8 5-4.8 0-8.7-3.9-8.7-8.7s3.9-8.7 8.7-8.7c3.1 0 5.9 1.7 7.4 4.3H15v2h8v-8h-2l.5 2.6z"/></svg>
                Shop on Amazon.com
              </a>
            </div>
          </details>
        </div>

        <aside class="post-sidebar">
          {hasAffiliate && (
            <details class="amazon-us-disclosure amazon-br-disclosure amazon-us-disclosure-sidebar amazon-br-disclosure-sidebar">
              <summary class="amazon-us-summary amazon-us-summary-sidebar amazon-br-summary-sidebar">
                <span class="amazon-us-summary-copy">
                  <span class="amazon-us-summary-eyebrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="margin-right:2px;position:relative;top:2px"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg> Brasil</span>
                  <span class="amazon-us-summary-title">Ver no {storeName}</span>
                </span>
                <span class="amazon-us-summary-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="product-box-sidebar">
                {productImage && (
                  <div class="product-box-sidebar-img-wrap">
                    <img
                      src={productImage}
                      alt={post.data.title}
                      class="product-box-sidebar-img"
                      loading="lazy"
                    />
