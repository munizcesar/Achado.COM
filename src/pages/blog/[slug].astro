---
import Layout from '../../layouts/Layout.astro';
import AdSense from '../../components/AdSense.astro';
import ChannelBanner from '../../components/ChannelBanner.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
}

const siteUrl = 'https://achadocerto.vip';
const postUrl = `${siteUrl}/blog/${post.slug}`;
const ogImage = post.data.image
  ? (post.data.image.startsWith('http') ? post.data.image : `${siteUrl}${post.data.image}`)
  : `${siteUrl}/og-default.jpg`;

const productImage = post.data.productImage || post.data.image || null;
const hasAffiliate  = !!post.data.affiliateUrl;
const price         = post.data.price || null;

function detectStore(url) {
  if (!url) return 'melhor preço';
  const urlLower = url.toLowerCase();
  if (urlLower.includes('mercadolivre.com') || urlLower.includes('meli.la')) return 'Mercado Livre';
  if (urlLower.includes('amazon.com')) return 'Amazon';
  if (urlLower.includes('magalu.com') || urlLower.includes('magazineluiza')) return 'Magalu';
  return 'melhor preço';
}
const storeName = detectStore(post.data.affiliateUrl);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description ?? '',
  image: ogImage,
  datePublished: post.data.date?.toISOString() ?? '',
  author: { '@type': 'Organization', name: 'AchadoCerto', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'AchadoCerto', url: siteUrl },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: post.data.category, item: `${siteUrl}/categorias/${post.data.category?.toLowerCase()}` },
    { '@type': 'ListItem', position: 4, name: post.data.title, item: postUrl }
  ]
};

const encodedTitle = encodeURIComponent(`${post.data.title} — AchadoCerto`);
const encodedUrl   = encodeURIComponent(postUrl);
const whatsappUrl  = `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`;
const twitterUrl   = `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const facebookUrl  = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;

const allPosts = await getCollection('blog');
function shuffleArray(arr) {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

const relatedByCategory = shuffleArray(
  allPosts.filter(p => p.slug !== post.slug && p.data.category === post.data.category)
);

const others = shuffleArray(
  allPosts.filter(p => p.slug !== post.slug && p.data.category !== post.data.category)
);

const relatedPosts = (relatedByCategory.length >= 3
  ? relatedByCategory
  : [...relatedByCategory, ...others]
).slice(0, 3);

const relatedPlaceholders = Array.from({ length: Math.max(0, 3 - relatedPosts.length) }, () => ({
  placeholder: true,
  title: 'Ver mais artigos',
  description: 'Explore mais reviews e guias no blog.',
  category: 'Explorar',
  slug: '/blog',
  image: '/og-default.jpg',
}));

const relatedDisplay = [...relatedPosts, ...relatedPlaceholders];
---

<Layout
  title={`${post.data.title} — AchadoCerto`}
  description={post.data.description}
  image={ogImage}
  schema={[articleSchema, breadcrumbSchema]}
>
  <article>

    <div style="background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding: 12px 0 0;" >
      <div class="container" style="max-width: 1100px;">
        <nav style="font-size:13px;color:var(--c-text-muted);margin-bottom:20px;display:flex;gap:6px;align-items:center;flex-wrap:nowrap;overflow:hidden;">
          <a href="/" style="color:var(--c-brand);white-space:nowrap;">Início</a><span style="flex-shrink:0;">›</span>
          <a href="/blog" style="color:var(--c-brand);white-space:nowrap;">Reviews</a><span style="flex-shrink:0;">›</span>
          {post.data.category && <a href={`/categorias/${post.data.category.toLowerCase()}`} style="color:var(--c-brand);white-space:nowrap;">{post.data.category}</a>}
          {post.data.category && <span style="flex-shrink:0;">›</span>}
          <span style="color:var(--c-text-light);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">{post.data.title}</span>
        </nav>

        <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--c-brand);display:block;margin-bottom:10px;">
          {post.data.category}
        </span>
        <h1 style="font-size:clamp(26px,4vw,42px);font-weight:800;letter-spacing:-.8px;line-height:1.2;color:var(--c-text);margin-bottom:16px;">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p style="font-size:18px;color:var(--c-text-sub);line-height:1.7;margin-bottom:24px;max-width:680px;">
            {post.data.description}
          </p>
        )}

        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:32px;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:16px;font-size:13px;color:var(--c-text-muted);flex-wrap:wrap;">
            <span style="display:flex;align-items:center;gap:5px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <time datetime={post.data.date?.toISOString?.() ?? ''}>{fmtDate(post.data.date)}</time>
            </span>
            <span style="display:flex;align-items:center;gap:5px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Equipe AchadoCerto
            </span>
            {post.data.tags?.length > 0 && post.data.tags.slice(0,3).map(tag => (
              <span style="background:var(--c-tag-bg);color:var(--c-tag-text);padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;">#{tag}</span>
            ))}
          </div>

          <div class="share-bar">
            <span class="share-bar-label">Compartilhar:</span>
            <div class="share-bar-btns">
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="sicon sicon-wa">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </a>
              <a href={twitterUrl} target="_blank" rel="noopener noreferrer" aria-label="X / Twitter" class="sicon sicon-x">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="sicon sicon-fb">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://t.me/achadocertovip" target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="sicon sicon-tg">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
              </a>
              <button class="sicon sicon-copy" id="share-copy-hdr" aria-label="Copiar link">
                <svg id="icon-copy-hdr" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                <svg id="icon-check-hdr" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
              <button class="sicon sicon-native" id="share-native-hdr" aria-label="Compartilhar">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    {post.data.image && (
      <div style="background:var(--c-bg);padding:0 0 40px;">
        <div class="container" style="max-width:1100px;">
          <picture>
            <source srcset={post.data.image} type="image/webp" />
            <img
              src={post.data.image}
              alt={post.data.title}
              style="width:100%;height:auto;max-height:500px;object-fit:contain;object-position:center;border-radius:var(--r-lg);box-shadow:var(--shadow-md);margin-top:-1px;background:#fff;"
              width="1100" height="619"
              loading="eager"
              fetchpriority="high"
              onerror="this.style.display='none';"
            />
          </picture>
        </div>
      </div>
    )}

    <div style="padding:32px 0 80px;background:var(--c-bg);">
      <div class="container post-content-grid" style="max-width:1100px;">

        <div class="prose">
          <Content />

          <div style="margin:32px 0;">
            <AdSense slot="3873859149" format="fluid" maxWidth="580px" />
          </div>

          {hasAffiliate && (
            <div class="product-box-final">
              {productImage && (
                <img
                  src={productImage}
                  alt={post.data.title}
                  class="product-box-final-img"
                  loading="lazy"
                />
              )}
              <div class="product-box-final-body">
                <p class="product-box-final-label">⭐ Gostou do review? Confira o preço agora</p>
                <p class="product-box-final-name">{post.data.title}</p>
                {price && <p class="product-box-final-price">{price}</p>}
                <a
                  href={post.data.affiliateUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-affiliate
                  data-product={post.data.title}
                  data-category={post.data.category}
                  class="product-box-final-btn"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  Ver no {storeName}
                </a>
                <p style="font-size:11px;color:var(--c-text-light);text-align:center;margin-top:8px;">Link de afiliado — sem custo extra para você</p>
              </div>
            </div>
          )}
        </div>

        <aside class="post-sidebar">
          {hasAffiliate && (
            <div class="product-box-sidebar">
              {productImage && (
                <div class="product-box-sidebar-img-wrap">
                  <img
                    src={productImage}
                    alt={post.data.title}
                    class="product-box-sidebar-img"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="product-box-sidebar-body">
                <p class="product-box-sidebar-label">Melhor preço</p>
                <p class="product-box-sidebar-name">{post.data.title}</p>
                {price && <p class="product-box-sidebar-price">{price}</p>}
                <a
                  href={post.data.affiliateUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-affiliate
                  data-product={post.data.title}
                  data-category={post.data.category}
                  class="product-box-sidebar-btn"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  Ver no {storeName}
                </a>
                <p class="product-box-sidebar-disclaimer">Link de afiliado — sem custo extra</p>
              </div>
            </div>
          )}

          <div class="sidebar-share-box">
            <p class="sidebar-share-title">Compartilhar</p>
            <div class="sidebar-share-grid">
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="sicon sicon-wa">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </a>
              <a href={twitterUrl} target="_blank" rel="noopener noreferrer" aria-label="X / Twitter" class="sicon sicon-x">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="sicon sicon-fb">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://t.me/achadocertovip" target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="sicon sicon-tg">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
              </a>
              <button class="sicon sicon-copy" id="share-copy-sb" aria-label="Copiar link">
                <svg id="icon-copy-sb" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                <svg id="icon-check-sb" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
              <button class="sicon sicon-native" id="share-native-sb" aria-label="Compartilhar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </button>
            </div>
          </div>

          <div style="margin-bottom:16px;">
            <AdSense slot="7473925904" format="auto" maxWidth="280px" />
          </div>

          <div style="background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-md);padding:20px;box-shadow:var(--shadow-sm);">
            <p style="font-size:12px;font-weight:700;text-transform:uppercase;color:var(--c-text-muted);margin-bottom:14px;">Navegar</p>
            <a href="/blog" style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--c-text-sub);padding:8px 0;border-bottom:1px solid var(--c-border);transition:color .2s;"
               onmouseover="this.style.color='var(--c-brand)'" onmouseout="this.style.color='var(--c-text-sub)'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
