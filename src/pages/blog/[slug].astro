  <script is:inline>
    (function(){
      function setupCopy(btnId, copyIconId, checkIconId) {
        var btn = document.getElementById(btnId);
        var ic  = document.getElementById(copyIconId);
        var ck  = document.getElementById(checkIconId);
        if (!btn) return;
        btn.addEventListener('click', function(){
          navigator.clipboard.writeText(window.location.href).then(function(){
            if (ic) ic.style.display = 'none';
            if (ck) ck.style.display = 'inline';
            btn.classList.add('sicon-copied');
            setTimeout(function(){
              if (ic) ic.style.display = 'inline';
              if (ck) ck.style.display = 'none';
              btn.classList.remove('sicon-copied');
            }, 1800);
          }).catch(function(){});
        });
      }
      setupCopy('share-copy-hdr', 'icon-copy-hdr', 'icon-check-hdr');
      setupCopy('share-copy-sb',  'icon-copy-sb',  'icon-check-sb');

      function setupNativeShare(btnId) {
        var btn = document.getElementById(btnId);
        if (!btn) return;
        if (!navigator.share) { btn.style.display = 'none'; return; }
        btn.addEventListener('click', function(){
          navigator.share({
            title: document.title,
            url: window.location.href
          }).catch(function(){});
        });
      }
      setupNativeShare('share-native-hdr');
      setupNativeShare('share-native-sb');
    })();
  </script>

