                )}
                <div class="product-box-sidebar-body">
                  <p class="product-box-sidebar-label">Melhor preço</p>
                  <p class="product-box-sidebar-name">{post.data.title}</p>
                  {price && <p class="product-box-sidebar-price">{price}</p>}
                  <a
                    href={post.data.affiliateUrl}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                    data-affiliate
                    data-product={post.data.title}
                    data-category={post.data.category}
                    class="product-box-sidebar-btn"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    Ver no {storeName}
                  </a>
                  <p class="product-box-sidebar-disclaimer">Link de afiliado — sem custo extra</p>
                </div>
              </div>
            </details>
          )}

          <details class="amazon-us-disclosure amazon-us-disclosure-sidebar">
            <summary class="amazon-us-summary amazon-us-summary-sidebar">
              <span class="amazon-us-summary-copy">
                <span class="amazon-us-summary-eyebrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="margin-right:2px;position:relative;top:2px"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> US / International</span>
                <span class="amazon-us-summary-title">Shop on Amazon.com</span>
              </span>
              <span class="amazon-us-summary-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="amazon-us-sidebar">
              <div class="amazon-us-sidebar-header">
                <svg width="28" height="19" viewBox="0 0 40 27" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="40" height="27" rx="3" fill="#B22234"/>
                  <rect y="2" width="40" height="2.08" fill="white"/>
                  <rect y="6.15" width="40" height="2.08" fill="white"/>
                  <rect y="10.31" width="40" height="2.08" fill="white"/>
                  <rect y="14.46" width="40" height="2.08" fill="white"/>
                  <rect y="18.62" width="40" height="2.08" fill="white"/>
                  <rect y="22.77" width="40" height="2.08" fill="white"/>
                  <rect width="16" height="14.5" fill="#3C3B6E"/>
                </svg>
                <span>International visitors</span>
              </div>
              <p class="amazon-us-sidebar-text">Shop equivalent or similar products on <strong>Amazon.com</strong> with fast US shipping</p>
              <a
                href={amazonUsUrl}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="amazon-us-sidebar-btn"
                data-affiliate
                data-product={post.data.title}
                data-category="amazon-us-sidebar"
              >
                Shop on Amazon.com
              </a>
              <p class="amazon-us-sidebar-disclaimer">Affiliate link � No extra cost to you</p>
            </div>
          </details>

          <div class="sidebar-share-box">
            <div class="sidebar-share-grid">
<a href={twitterUrl} target="_blank" rel="noopener noreferrer" aria-label="X / Twitter" class="sicon sicon-x"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
