---
import Layout from '../../layouts/Layout.astro';
import AdSense from '../../components/AdSense.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
}

const siteUrl = 'https://achadocerto.vip';
const postUrl = `${siteUrl}/blog/${post.slug}`;
const ogImage = post.data.image
  ? (post.data.image.startsWith('http') ? post.data.image : `${siteUrl}${post.data.image}`)
  : `${siteUrl}/og-default.jpg`;

const productImage = post.data.productImage || post.data.image || null;
const hasAffiliate  = !!post.data.affiliateUrl;
const price         = post.data.price || null;

function detectStore(url) {
  if (!url) return 'melhor preço';
  const urlLower = url.toLowerCase();
  if (urlLower.includes('mercadolivre.com') || urlLower.includes('meli.la')) return 'Mercado Livre';
  if (urlLower.includes('amazon.com')) return 'Amazon';
  if (urlLower.includes('magalu.com') || urlLower.includes('magazineluiza')) return 'Magalu';
  return 'melhor preço';
}
const storeName = detectStore(post.data.affiliateUrl);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description ?? '',
  image: ogImage,
  datePublished: post.data.date?.toISOString() ?? '',
  author: { '@type': 'Organization', name: 'AchadoCerto', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'AchadoCerto', url: siteUrl },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: post.data.category, item: `${siteUrl}/categorias/${post.data.category?.toLowerCase()}` },
    { '@type': 'ListItem', position: 4, name: post.data.title, item: postUrl }
  ]
};

const shareText  = encodeURIComponent(`${post.data.title} — AchadoCerto`);
const shareUrl   = encodeURIComponent(postUrl);
const whatsappUrl = `https://wa.me/?text=${shareText}%20${shareUrl}`;
const twitterUrl  = `https://x.com/intent/tweet?text=${shareText}&url=${shareUrl}`;

const allPosts = await getCollection('blog');
function shuffleArray(arr) {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

const relatedByCategory = shuffleArray(
  allPosts.filter(p => p.slug !== post.slug && p.data.category === post.data.category)
);

const others = shuffleArray(
  allPosts.filter(p => p.slug !== post.slug && p.data.category !== post.data.category)
);

const relatedPosts = (relatedByCategory.length >= 3
  ? relatedByCategory
  : [...relatedByCategory, ...others]
).slice(0, 3);

const relatedPlaceholders = Array.from({ length: Math.max(0, 3 - relatedPosts.length) }, () => ({
  placeholder: true,
  title: 'Ver mais artigos',
  description: 'Explore mais reviews e guias no blog.',
  category: 'Explorar',
  slug: '/blog',
  image: '/og-default.jpg',
}));

const relatedDisplay = [...relatedPosts, ...relatedPlaceholders];
---

<Layout
  title={`${post.data.title} — AchadoCerto`}
  description={post.data.description}
  image={ogImage}
  schema={[articleSchema, breadcrumbSchema]}
>
  <article>

    <!-- HERO -->
    <div style="background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding: 12px 0 0;" >
      <div class="container" style="max-width: 820px;">
        <nav style="font-size:13px;color:var(--c-text-muted);margin-bottom:20px;display:flex;gap:6px;align-items:center;flex-wrap:nowrap;overflow:hidden;">
          <a href="/" style="color:var(--c-brand);white-space:nowrap;">Início</a><span style="flex-shrink:0;">›</span>
          <a href="/blog" style="color:var(--c-brand);white-space:nowrap;">Reviews</a><span style="flex-shrink:0;">›</span>
          {post.data.category && <a href={`/categorias/${post.data.category.toLowerCase()}`} style="color:var(--c-brand);white-space:nowrap;">{post.data.category}</a>}
          {post.data.category && <span style="flex-shrink:0;">›</span>}
          <span style="color:var(--c-text-light);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">{post.data.title}</span>
        </nav>

        <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--c-brand);display:block;margin-bottom:10px;">
          {post.data.category}
        </span>
        <h1 style="font-size:clamp(26px,4vw,42px);font-weight:800;letter-spacing:-.8px;line-height:1.2;color:var(--c-text);margin-bottom:16px;">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p style="font-size:18px;color:var(--c-text-sub);line-height:1.7;margin-bottom:24px;max-width:680px;">
            {post.data.description}
          </p>
        )}

        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:32px;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:16px;font-size:13px;color:var(--c-text-muted);flex-wrap:wrap;">
            <span style="display:flex;align-items:center;gap:5px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <time datetime={post.data.date?.toISOString?.() ?? ''}>{fmtDate(post.data.date)}</time>
            </span>
            <span style="display:flex;align-items:center;gap:5px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Equipe AchadoCerto
            </span>
            {post.data.tags?.length > 0 && post.data.tags.slice(0,3).map(tag => (
              <span style="background:var(--c-tag-bg);color:var(--c-tag-text);padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;">#{tag}</span>
            ))}
          </div>
          <div class="share-buttons">
            <span class="share-label">Compartilhar:</span>
            <a href={twitterUrl} target="_blank" rel="noopener noreferrer" aria-label="X" class="share-btn share-x">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="share-btn share-whatsapp">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            </a>
            <a href="https://www.instagram.com/achadocertovip/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="share-btn share-instagram">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- IMAGEM PRINCIPAL -->
    {post.data.image && (
      <div style="background:var(--c-bg);padding:0 0 40px;">
        <div class="container" style="max-width:820px;">
          <picture>
            <source srcset={post.data.image} type="image/webp" />
            <img
              src={post.data.image}
              alt={post.data.title}
              style="width:100%;height:auto;max-height:500px;object-fit:contain;object-position:center;border-radius:var(--r-lg);box-shadow:var(--shadow-md);margin-top:-1px;background:#fff;"
              width="820" height="461"
              loading="eager"
              fetchpriority="high"
              onerror="this.style.display='none';"
            />
          </picture>
        </div>
      </div>
    )}

    <!-- CONTEÚDO + SIDEBAR -->
    <div style="padding:32px 0 80px;background:var(--c-bg);">
      <div class="container post-content-grid" style="max-width:820px;">

        <div class="prose">
          <Content />

          <!-- AD 1: sandwich editorial —  após o conteúdo -->
          <div style="margin:40px 0 32px;border-top:1px solid var(--c-border);padding-top:32px;">
            <p style="font-size:10px;text-align:center;color:var(--c-text-light);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase;">Publicidade</p>
            <AdSense slot="2844415754" format="auto" maxWidth="680px" minHeight="90px" />
          </div>

          <!-- AD 2: in-article -->
          <div style="margin:32px 0;">
            <p style="font-size:10px;text-align:center;color:var(--c-text-light);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase;">Publicidade</p>
            <AdSense slot="3873859149" format="fluid" maxWidth="580px" minHeight="90px" />
          </div>

          <!-- BOX CTA FINAL -->
          {hasAffiliate && (
            <div class="product-box-final">
              {productImage && (
                <img
                  src={productImage}
                  alt={post.data.title}
                  class="product-box-final-img"
                  loading="lazy"
                />
              )}
              <div class="product-box-final-body">
                <p class="product-box-final-label">⭐ Gostou do review? Confira o preço agora</p>
                <p class="product-box-final-name">{post.data.title}</p>
                {price && <p class="product-box-final-price">{price}</p>}
                <a
                  href={post.data.affiliateUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-affiliate
                  data-product={post.data.title}
                  data-category={post.data.category}
                  class="btn-cta-large"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  Ver no {storeName}
                </a>
                <p style="font-size:11px;color:var(--c-text-light);text-align:center;margin-top:8px;">Link de afiliado — sem custo extra para você</p>
              </div>
            </div>
          )}
        </div>

        <!-- SIDEBAR -->
        <aside class="post-sidebar">
          {hasAffiliate && (
            <div class="product-box-sidebar">
              {productImage && (
                <div class="product-box-sidebar-img-wrap">
                  <img
                    src={productImage}
                    alt={post.data.title}
                    class="product-box-sidebar-img"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="product-box-sidebar-body">
                <p class="product-box-sidebar-label">Melhor preço</p>
                <p class="product-box-sidebar-name">{post.data.title}</p>
                {price && <p class="product-box-sidebar-price">{price}</p>}
                <a
                  href={post.data.affiliateUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-affiliate
                  data-product={post.data.title}
                  data-category={post.data.category}
                  class="btn-cta-sidebar"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  Ver no {storeName}
                </a>
                <p class="product-box-sidebar-disclaimer">Link de afiliado — sem custo extra</p>
              </div>
            </div>
          )}

          <div style="background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-md);padding:20px;margin-bottom:16px;box-shadow:var(--shadow-sm);">
            <p style="font-size:12px;font-weight:700;text-transform:uppercase;color:var(--c-text-muted);margin-bottom:14px;">Compartilhar</p>
            <div style="display:flex;gap:10px;">
              <a href={twitterUrl} target="_blank" rel="noopener noreferrer" aria-label="X" class="share-btn share-x">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="share-btn share-whatsapp">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              </a>
              <a href="https://www.instagram.com/achadocertovip/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="share-btn share-instagram">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            </div>
          </div>

          <!-- AD SIDEBAR -->
          <div style="margin-bottom:16px;">
            <p style="font-size:10px;text-align:center;color:var(--c-text-light);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase;">Publicidade</p>
            <AdSense slot="7473925904" format="auto" maxWidth="280px" minHeight="250px" />
          </div>

          <div style="background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-md);padding:20px;box-shadow:var(--shadow-sm);">
            <p style="font-size:12px;font-weight:700;text-transform:uppercase;color:var(--c-text-muted);margin-bottom:14px;">Navegar</p>
            <a href="/blog" style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--c-text-sub);padding:8px 0;border-bottom:1px solid var(--c-border);transition:color .2s;"
               onmouseover="this.style.color='var(--c-brand)'" onmouseout="this.style.color='var(--c-text-sub)'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
              Todos os reviews
            </a>
            <a href="/" style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--c-text-sub);padding:8px 0;transition:color .2s;"
               onmouseover="this.style.color='var(--c-brand)'" onmouseout="this.style.color='var(--c-text-sub)'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              Página inicial
            </a>
          </div>
        </aside>
      </div>
    </div>

    <!-- ARTIGOS RELACIONADOS -->
    {relatedPosts.length > 0 && (
      <section class="related-section">
        <div class="container">
          <div class="related-header">
            <div>
              <span class="related-eyebrow">Continue lendo</span>
              <h2 class="related-heading">Artigos Relacionados</h2>
            </div>
            <a href="/blog" class="related-see-all">
              Ver todos
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
          <div class="related-grid">
            {relatedDisplay.map(related => {
              const isPlaceholder = related.placeholder;
              const relImg = isPlaceholder ? related.image : (related.data?.productImage || related.data?.image || '/og-default.jpg');
              const relUrl = isPlaceholder ? related.slug : `/blog/${related.slug}`;
              const relTitle = isPlaceholder ? related.title : related.data?.title;
              const relDesc = isPlaceholder ? related.description : related.data?.description;
              const relCat = isPlaceholder ? related.category : related.data?.category;
              return (
                <a href={relUrl} class="related-card">
                  <div class="related-img-wrap">
                    <img src={relImg} alt={relTitle} class="related-img" loading="lazy" width="320" height="200" />
                  </div>
                  <div class="related-body">
                    <span class="related-cat">{relCat}</span>
                    <h3 class="related-title">{relTitle}</h3>
                    {relDesc && <p class="related-desc">{relDesc}</p>}
                    <span class="related-cta">
                      {isPlaceholder ? 'Explorar' : 'Ler review'}
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ONDE COMPRAR COM SEGURANÇA -->
    <div style="background:var(--c-surface);padding:40px 0;border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border);">
      <div class="container" style="max-width:820px;">
        <h2 style="font-size:22px;font-weight:800;margin:0 0 8px;color:var(--c-text);">🛡️ Onde Comprar com Segurança</h2>
        <p style="font-size:14px;color:var(--c-text-sub);margin:0 0 20px;line-height:1.6;">
          Dicas específicas para comprar {detectStore(post.data.affiliateUrl) === 'melhor preço' ? 'online' : `no ${detectStore(post.data.affiliateUrl)}`} com tranquilidade
        </p>
        <div style="display:grid;gap:12px;">
          <div style="background:#fff;border:1px solid var(--c-border);border-left:4px solid var(--c-brand);border-radius:var(--r-md);padding:16px 20px;">
            <div style="display:flex;align-items:start;gap:12px;">
              <div style="background:var(--c-brand-soft);color:var(--c-brand);width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;">⭐</div>
              <div style="flex:1;">
                <h3 style="font-size:15px;font-weight:700;color:var(--c-text);margin:0 0 6px;">Verifique a reputação do vendedor</h3>
                <p style="font-size:14px;color:var(--c-text-sub);line-height:1.6;margin:0;">
                  {detectStore(post.data.affiliateUrl) === 'Mercado Livre' && 'Procure vendedores com selo MercadoLíder Platinum e mais de 95% de avaliações positivas.'}
                  {detectStore(post.data.affiliateUrl) === 'Amazon' && 'Prefira produtos vendidos e entregues pela Amazon ou vendedores com avaliação acima de 4.5 estrelas.'}
                  {detectStore(post.data.affiliateUrl) === 'Magalu' && 'Verifique a nota do vendedor (acima de 4 estrelas). Vendedores oficiais têm o selo "Vendido e entregue por Magazine Luiza".'}
                  {!['Mercado Livre', 'Amazon', 'Magalu'].includes(detectStore(post.data.affiliateUrl)) && 'Busque vendedores com alta reputação, milhares de vendas e tempo significativo de cadastro na plataforma.'}
                </p>
              </div>
            </div>
          </div>
          <div style="background:#fff;border:1px solid var(--c-border);border-left:4px solid var(--c-brand);border-radius:var(--r-md);padding:16px 20px;">
            <div style="display:flex;align-items:start;gap:12px;">
              <div style="background:var(--c-brand-soft);color:var(--c-brand);width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;">↩️</div>
              <div style="flex:1;">
                <h3 style="font-size:15px;font-weight:700;color:var(--c-text);margin:0 0 6px;">Leia a política de devolução</h3>
                <p style="font-size:14px;color:var(--c-text-sub);line-height:1.6;margin:0;">Você tem 7 dias para desistir da compra (CDC). Verifique se há "troca grátis" ou se você arcará com o frete de retorno antes de finalizar.</p>
              </div>
            </div>
          </div>
          <div style="background:#fff;border:1px solid var(--c-border);border-left:4px solid var(--c-brand);border-radius:var(--r-md);padding:16px 20px;">
            <div style="display:flex;align-items:start;gap:12px;">
              <div style="background:var(--c-brand-soft);color:var(--c-brand);width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;">💳</div>
              <div style="flex:1;">
                <h3 style="font-size:15px;font-weight:700;color:var(--c-text);margin:0 0 6px;">Use pagamento dentro da plataforma</h3>
                <p style="font-size:14px;color:var(--c-text-sub);line-height:1.6;margin:0;">
                  {detectStore(post.data.affiliateUrl) === 'Mercado Livre' && 'Sempre pague via Mercado Pago para ter proteção na compra.'}
                  {detectStore(post.data.affiliateUrl) === 'Amazon' && 'Pague via sistema da Amazon para ter cobertura da Garantia A-Z.'}
                  {detectStore(post.data.affiliateUrl) === 'Magalu' && 'Use o sistema de pagamento do Magalu — cartão de crédito oferece chargeback em caso de problemas.'}
                  {!['Mercado Livre', 'Amazon', 'Magalu'].includes(detectStore(post.data.affiliateUrl)) && 'Sempre pague pelo sistema oficial da plataforma. Cartão de crédito oferece proteção extra com possibilidade de contestação.'}
                </p>
              </div>
            </div>
          </div>
          <div style="background:linear-gradient(135deg,#f0f4ff,#e8f0fe);border:1px solid var(--c-brand);border-radius:var(--r-md);padding:16px;text-align:center;margin-top:8px;">
            <p style="font-size:13px;color:var(--c-text-sub);margin:0 0 10px;">Mais dúvidas sobre compras online?</p>
            <a href="/faq" class="btn-cta-primary">
              Ver Perguntas Frequentes
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <style>
    .post-content-grid {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 48px;
      align-items: start;
    }
    .post-sidebar { position: sticky; top: 88px; }

    /* BOX CTA FINAL */
    .product-box-final {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      background: linear-gradient(135deg, #f0f4ff 0%, #e8f0fe 100%);
      border: 2px solid var(--c-brand);
      border-radius: var(--r-lg);
      padding: 32px 28px;
      margin: 48px 0 0;
      box-shadow: 0 6px 28px rgba(26,86,219,.12);
    }
    .product-box-final-img {
      width: 140px; height: 140px;
      object-fit: contain;
      border-radius: var(--r-md);
      background: #fff;
      border: 1px solid var(--c-border);
      padding: 8px;
      margin-bottom: 16px;
    }
    .product-box-final-body { width: 100%; }
    .product-box-final-label { font-size: 13px; font-weight: 700; color: var(--c-brand); margin-bottom: 6px; }
    .product-box-final-name  { font-size: 20px; font-weight: 800; color: var(--c-text) !important; margin-bottom: 8px; line-height: 1.3; }
    .product-box-final-price { font-size: 28px; font-weight: 800; color: var(--c-brand); margin-bottom: 16px; }

    /* BOX SIDEBAR */
    .product-box-sidebar {
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-top: 3px solid var(--c-brand);
      border-radius: var(--r-md);
      overflow: hidden;
      margin-bottom: 16px;
      box-shadow: var(--shadow-sm);
    }
    .product-box-sidebar-img-wrap {
      width: 100%; aspect-ratio: 1/1;
      background: #fff;
      display: flex; align-items: center; justify-content: center;
      border-bottom: 1px solid var(--c-border);
      padding: 16px;
    }
    .product-box-sidebar-img { width: 100%; height: 100%; object-fit: contain; }
    .product-box-sidebar-body { padding: 16px; }
    .product-box-sidebar-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--c-text-muted); margin-bottom: 4px; }
    .product-box-sidebar-name  { font-size: 14px; font-weight: 700; color: var(--c-text); margin-bottom: 8px; line-height: 1.4; }
    .product-box-sidebar-price { font-size: 20px; font-weight: 800; color: var(--c-brand); margin-bottom: 12px; }
    .product-box-sidebar-disclaimer { font-size: 10px; color: var(--c-text-light); text-align: center; margin-top: 8px; }

    /* SHARE */
    .share-buttons { display:flex; align-items:center; gap:8px; }
    .share-label   { font-size:12px; font-weight:600; color:var(--c-text-muted); white-space:nowrap; }
    .share-btn {
      width:36px; height:36px; border-radius:50%;
      display:flex; align-items:center; justify-content:center;
      color:#fff; transition:transform .2s,opacity .2s; flex-shrink:0;
    }
    .share-btn:hover { transform:scale(1.12); opacity:.9; }
    .share-x         { background:#000; }
    .share-whatsapp  { background:#25D366; }
    .share-instagram { background:radial-gradient(circle at 30% 107%,#fdf497 0%,#fdf497 5%,#fd5949 45%,#d6249f 60%,#285AEB 90%); }

    /* PROSE */
    .prose { color:var(--c-text); font-size:17px; line-height:1.8; }
    .prose h2 { font-size:26px; font-weight:800; letter-spacing:-.4px; margin:40px 0 16px; color:var(--c-text); }
    .prose h3 { font-size:20px; font-weight:700; margin:32px 0 12px; color:var(--c-text); }
    .prose p  { margin-bottom:20px; }
    .prose a  { color:var(--c-brand); text-decoration:underline; }
    .prose a:hover { color:var(--c-brand-dark); }
    .prose ul,.prose ol { margin:0 0 20px 24px; }
    .prose li { margin-bottom:8px; }
    .prose blockquote { border-left:3px solid var(--c-brand); padding:12px 20px; background:var(--c-brand-soft); border-radius:0 var(--r-sm) var(--r-sm) 0; margin:24px 0; font-style:italic; color:var(--c-text-sub); }
    .prose img { border-radius:var(--r-md); margin:24px 0; box-shadow:var(--shadow-md); }
    .prose code { background:var(--c-bg); padding:2px 6px; border-radius:4px; font-size:14px; }
    .prose strong { font-weight:700; color:var(--c-text); }
    .prose hr { border:none; border-top:1px solid var(--c-border); margin:40px 0; }
    .prose table { width:100%; border-collapse:collapse; margin:24px 0; font-size:15px; }
    .prose th { background:var(--c-bg); padding:10px 14px; text-align:left; font-weight:700; border:1px solid var(--c-border); }
    .prose td { padding:10px 14px; border:1px solid var(--c-border); }
    .prose tr:nth-child(even) td { background:var(--c-bg); }

    /* RELATED */
    .related-section { background:var(--c-surface); border-top:1px solid var(--c-border); padding:48px 0 56px; }
    .related-header { display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:28px; gap:16px; }
    .related-eyebrow { display:block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.9px; color:var(--c-brand); margin-bottom:4px; }
    .related-heading { font-size:clamp(20px,3vw,26px); font-weight:800; letter-spacing:-.4px; color:var(--c-text); margin:0; }
    .related-see-all { display:inline-flex; align-items:center; gap:5px; font-size:13.5px; font-weight:600; color:var(--c-brand); white-space:nowrap; transition:gap .18s; }
    .related-see-all:hover { gap:9px; text-decoration:underline; }
    .related-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
    .related-card { display:flex; flex-direction:column; background:var(--c-surface); border:1px solid var(--c-border); border-radius:var(--r-md); overflow:hidden; text-decoration:none; box-shadow:var(--shadow-sm); transition:transform .2s,box-shadow .2s,border-color .2s; }
    .related-card:hover { transform:translateY(-3px); box-shadow:var(--shadow-lg); border-color:var(--c-brand); }
    .related-img-wrap { width:100%; aspect-ratio:16/10; background:#fff; display:flex; align-items:center; justify-content:center; overflow:hidden; border-bottom:1px solid var(--c-border); padding:16px; }
    .related-img { max-width:100%; max-height:100%; object-fit:contain; transition:transform .35s; }
    .related-card:hover .related-img { transform:scale(1.04); }
    .related-body { padding:16px 18px 18px; display:flex; flex-direction:column; gap:6px; flex:1; }
    .related-cat { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.7px; color:var(--c-brand); }
    .related-title { font-size:15px; font-weight:700; line-height:1.35; color:var(--c-text); margin:0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .related-desc { font-size:13px; color:var(--c-text-muted); line-height:1.5; margin:0; flex:1; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .related-cta { display:inline-flex; align-items:center; gap:5px; font-size:13px; font-weight:600; color:var(--c-brand); margin-top:6px; transition:gap .18s; }
    .related-card:hover .related-cta { gap:9px; }

    @media (max-width: 768px) {
      .post-content-grid { display:block !important; }
      .post-sidebar { position:static; margin-top:40px; }
      .prose { padding:0 4px; }
      .share-buttons { width:100%; justify-content:flex-start; margin-top:12px; }
      .product-box-final { padding:24px 16px; }
      .related-grid { grid-template-columns:1fr; }
      .related-header { flex-direction:column; align-items:flex-start; }
    }
    @media (min-width: 480px) and (max-width: 768px) {
      .related-grid { grid-template-columns:repeat(2,1fr); }
    }
  </style>
</Layout>
