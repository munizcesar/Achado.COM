---
import Layout from '../../layouts/Layout.astro';
import AdSense from '../../components/AdSense.astro';
import ChannelBanner from '../../components/ChannelBanner.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function fmtDate(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
}

function mapCatSlug(cat) {
  if (!cat) return '';
  const s = cat.toLowerCase();
  if (s === 'lar') return 'casa';
  if (s === 'esporte') return 'esportes';
  return s;
}

const catSlug = mapCatSlug(post.data.category);

const siteUrl = 'https://achadocerto.vip';
const postUrl = `${siteUrl}/blog/${post.slug}`;

const ogImageStatic = post.data.image
  ? (post.data.image.startsWith('http') ? post.data.image : `${siteUrl}${post.data.image}`)
  : `${siteUrl}/og-default.jpg`;

const ogImageWorkerParams = new URLSearchParams({
  title: post.data.title || '',
  img:   post.data.productImage || post.data.image || '',
  cat:   post.data.category || '',
});
const ogImageDynamic = `${siteUrl}/og-image/${post.slug}?${ogImageWorkerParams.toString()}`;

const productImage = post.data.productImage || post.data.image || null;
const hasAffiliate  = !!post.data.affiliateUrl;
const price         = post.data.price || null;

function detectStore(url) {
  if (!url) return 'melhor pre\u00e7o';
  const urlLower = url.toLowerCase();
  if (urlLower.includes('mercadolivre.com') || urlLower.includes('meli.la')) return 'Mercado Livre';
  if (urlLower.includes('amazon.com')) return 'Amazon';
  if (urlLower.includes('magalu.com') || urlLower.includes('magazineluiza')) return 'Magalu';
  return 'melhor pre\u00e7o';
}
const storeName = detectStore(post.data.affiliateUrl);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  headline: post.data.title,
  description: post.data.description ?? '',
  image: ogImageStatic,
  datePublished: post.data.date?.toISOString() ?? '',
  author: { '@type': 'Organization', name: 'AchadoCerto', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'AchadoCerto', url: siteUrl },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  itemReviewed: { '@type': 'Product', name: post.data.title, image: ogImageStatic },
  reviewRating: { '@type': 'Rating', ratingValue: post.data.rating ?? 4, bestRating: 5, worstRating: 1 },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'In\u00edcio', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: post.data.category, item: `${siteUrl}/categorias/${catSlug}` },
    { '@type': 'ListItem', position: 4, name: post.data.title, item: postUrl }
  ]
};

const allPosts = await getCollection('blog');
function shuffleArray(arr) {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

const relatedByCategory = shuffleArray(
  allPosts.filter(p => p.slug !== post.slug && mapCatSlug(p.data.category) === catSlug)
);
const others = shuffleArray(
  allPosts.filter(p => p.slug !== post.slug && mapCatSlug(p.data.category) !== catSlug)
);
const relatedPosts = (relatedByCategory.length >= 3
  ? relatedByCategory
  : [...relatedByCategory, ...others]
).slice(0, 3);
const relatedPlaceholders = Array.from({ length: Math.max(0, 3 - relatedPosts.length) }, () => ({
  placeholder: true, title: 'Ver mais artigos', description: 'Explore mais reviews e guias no blog.',
  category: 'Explorar', slug: '/blog', image: '/og-default.jpg',
}));
const relatedDisplay = [...relatedPosts, ...relatedPlaceholders];
---

<Layout
  title={`${post.data.title} \u2014 AchadoCerto`}
  description={post.data.description}
  image={ogImageDynamic}
  schema={[articleSchema, breadcrumbSchema]}
>
  <article>

    <!-- HERO -->
    <div style="background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding: 12px 0 0;">
      <div class="container post-narrow">
        <nav style="font-size:13px;color:var(--c-text-muted);margin-bottom:20px;display:flex;gap:6px;align-items:center;flex-wrap:nowrap;overflow:hidden;">
          <a href="/" style="color:var(--c-brand);white-space:nowrap;">In\u00edcio</a><span style="flex-shrink:0;">&rsaquo;</span>
          <a href="/blog" style="color:var(--c-brand);white-space:nowrap;">Reviews</a><span style="flex-shrink:0;">&rsaquo;</span>
          {post.data.category && <a href={`/categorias/${catSlug}`} style="color:var(--c-brand);white-space:nowrap;">{post.data.category}</a>}
          {post.data.category && <span style="flex-shrink:0;">&rsaquo;</span>}
          <span style="color:var(--c-text-light);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">{post.data.title}</span>
        </nav>

        <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--c-brand);display:block;margin-bottom:10px;">
          {post.data.category}
        </span>
        <h1 style="font-size:clamp(24px,4vw,42px);font-weight:800;letter-spacing:-.8px;line-height:1.2;color:var(--c-text);margin-bottom:16px;">
          {post.data.title}
        </h1>
        {post.data.description && (
          <p style="font-size:clamp(16px,2vw,18px);color:var(--c-text-sub);line-height:1.7;margin-bottom:24px;max-width:680px;">
            {post.data.description}
          </p>
        )}

        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:32px;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:16px;font-size:13px;color:var(--c-text-muted);flex-wrap:wrap;">
            <span style="display:flex;align-items:center;gap:5px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <time datetime={post.data.date?.toISOString?.() ?? ''}>{fmtDate(post.data.date)}</time>
            </span>
            <span style="display:flex;align-items:center;gap:5px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Equipe AchadoCerto
            </span>
            {post.data.tags?.length > 0 && post.data.tags.slice(0,3).map(tag => (
              <span style="background:var(--c-tag-bg);color:var(--c-tag-text);padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;">#{tag}</span>
            ))}
          </div>

          <!-- SHARE BUTTONS HERO -->
          <ShareButtons title={post.data.title} url={postUrl} />
        </div>
      </div>
    </div>

    <!-- IMAGEM PRINCIPAL -->
    {post.data.image && (
      <div style="background:var(--c-bg);padding:0 0 40px;">
        <div class="container post-narrow">
          <picture>
            <source srcset={post.data.image} type="image/webp" />
            <img
              src={post.data.image}
              alt={post.data.title}
              style="width:100%;height:auto;max-height:500px;object-fit:contain;object-position:center;border-radius:var(--r-lg);box-shadow:var(--shadow-md);margin-top:-1px;background:#fff;"
              width="820" height="461"
              loading="eager"
              fetchpriority="high"
              onerror="this.style.display='none';"
            />
          </picture>
        </div>
      </div>
    )}

    <!-- CONTEÚDO + SIDEBAR -->
    <div style="padding:32px 0 80px;background:var(--c-bg);">
      <div class="container post-content-grid">

        <div class="prose">
          <Content />

          <div style="margin:40px 0 32px;border-top:1px solid var(--c-border);padding-top:32px;">
            <p style="font-size:10px;text-align:center;color:var(--c-text-light);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase;">Publicidade</p>
            <AdSense slot="2844415754" format="auto" maxWidth="680px" minHeight="90px" />
          </div>

          <div style="margin:32px 0;">
            <p style="font-size:10px;text-align:center;color:var(--c-text-light);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase;">Publicidade</p>
            <AdSense slot="3873859149" format="fluid" maxWidth="580px" minHeight="90px" />
          </div>

          {hasAffiliate && (
            <div class="product-box-final">
              {productImage && (
                <img src={productImage} alt={post.data.title} class="product-box-final-img" loading="lazy" />
              )}
              <div class="product-box-final-body">
                <p class="product-box-final-label">⭐ Gostou do review? Confira o pre\u00e7o agora</p>
                <p class="product-box-final-name">{post.data.title}</p>
                {price && <p class="product-box-final-price">{price}</p>}
                <a
                  href={post.data.affiliateUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-affiliate
                  data-product={post.data.title}
                  data-category={post.data.category}
                  class="btn-cta-large"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  Ver no {storeName}
                </a>
                <p style="font-size:11px;color:var(--c-text-light);text-align:center;margin-top:8px;">Link de afiliado \u2014 sem custo extra para voc\u00ea</p>
              </div>
            </div>
          )}

          <!-- SHARE BUTTONS FINAL (dentro do prose) -->
          <div style="margin-top:40px;">
            <ShareButtons title={post.data.title} url={postUrl} />
          </div>
        </div>

        <!-- SIDEBAR -->
        <aside class="post-sidebar">
          {hasAffiliate && (
            <div class="product-box-sidebar">
              {productImage && (
                <div class="product-box-sidebar-img-wrap">
                  <img src={productImage} alt={post.data.title} class="product-box-sidebar-img" loading="lazy" />
                </div>
              )}
              <div class="product-box-sidebar-body">
                <p class="product-box-sidebar-label">Melhor pre\u00e7o</p>
                <p class="product-box-sidebar-name">{post.data.title}</p>
                {price && <p class="product-box-sidebar-price">{price}</p>}
                <a
                  href={post.data.affiliateUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-affiliate
                  data-product={post.data.title}
                  data-category={post.data.category}
                  class="btn-cta-sidebar"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  Ver no {storeName}
                </a>
                <p class="product-box-sidebar-disclaimer">Link de afiliado \u2014 sem custo extra</p>
              </div>
            </div>
          )}

          <!-- SIDEBAR SHARE -->
          <div style="background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-md);padding:20px;margin-bottom:16px;box-shadow:var(--shadow-sm);">
            <p style="font-size:12px;font-weight:700;text-transform:uppercase;color:var(--c-text-muted);margin-bottom:14px;">Compartilhar</p>
            <ShareButtons title={post.data.title} url={postUrl} />
          </div>

          <div style="margin-bottom:16px;">
            <p style="font-size:10px;text-align:center;color:var(--c-text-light);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase;">Publicidade</p>
            <AdSense slot="7473925904" format="auto" maxWidth="280px" minHeight="250px" />
          </div>

          <div style="background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--r-md);padding:20px;box-shadow:var(--shadow-sm);">
            <p style="font-size:12px;font-weight:700;text-transform:uppercase;color:var(--c-text-muted);margin-bottom:14px;">Navegar</p>
            <a href="/blog" style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--c-text-sub);padding:8px 0;border-bottom:1px solid var(--c-border);transition:color .2s;"
               onmouseover="this.style.color='var(--c-brand)'" onmouseout="this.style.color='var(--c-text-sub)'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
              Todos os reviews
            </a>
            <a href="/" style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--c-text-sub);padding:8px 0;transition:color .2s;"
               onmouseover="this.style.color='var(--c-brand)'" onmouseout="this.style.color='var(--c-text-sub)'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              P\u00e1gina inicial
            </a>
          </div>
        </aside>
      </div>
    </div>

    <!-- CHANNEL BANNER — WhatsApp + Telegram -->
    <ChannelBanner />

    <!-- ARTIGOS RELACIONADOS -->
    {relatedPosts.length > 0 && (
      <section class="related-section">
        <div class="container">
          <div class="related-header">
            <div class="related-header-titles">
              <span class="related-eyebrow">Continue lendo</span>
              <h2 class="related-heading">Artigos Relacionados</h2>
            </div>
            <a href={`/categorias/${catSlug}`} class="related-see-all">
              Ver todos em {post.data.category}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
          <div class="related-grid">
            {relatedDisplay.map(related => {
              const isPlaceholder = related.placeholder;
              const relImg = isPlaceholder ? related.image : (related.data?.productImage || related.data?.image || '/og-default.jpg');
              const relUrl = isPlaceholder ? related.slug : `/blog/${related.slug}`;
              const relTitle = isPlaceholder ? related.title : related.data?.title;
              const relDesc = isPlaceholder ? related.description : related.data?.description;
              const relCat = isPlaceholder ? related.category : related.data?.category;
              return (
                <a href={relUrl} class="related-card">
                  <div class="related-img-wrap">
                    <img src={relImg} alt={relTitle} class="related-img" loading="lazy" width="400" height="250" />
                  </div>
                  <div class="related-body">
                    <span class="related-cat">{relCat}</span>
                    <h3 class="related-title">{relTitle}</h3>
                    {relDesc && <p class="related-desc">{relDesc}</p>}
                    <span class="related-cta">
                      {isPlaceholder ? 'Explorar' : 'Ler review'}
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ONDE COMPRAR COM SEGURANÇA -->
    <div style="background:var(--c-surface);padding:40px 0;border-top:1px solid var(--c-border);border-bottom:1px solid var(--c-border);">
      <div class="container post-narrow">
        <h2 style="font-size:clamp(18px,2.5vw,22px);font-weight:800;margin:0 0 8px;color:var(--c-text);">&#x1F6E1;&#xFE0F; Onde Comprar com Seguran\u00e7a</h2>
        <p style="font-size:clamp(13px,1.5vw,14px);color:var(--c-text-sub);margin:0 0 20px;line-height:1.6;">
          Dicas espec\u00edficas para comprar {detectStore(post.data.affiliateUrl) === 'melhor pre\u00e7o' ? 'online' : `no ${detectStore(post.data.affiliateUrl)}`} com tranquilidade
        </p>
        <div style="display:grid;gap:12px;">
          <div style="background:#fff;border:1px solid var(--c-border);border-left:4px solid var(--c-brand);border-radius:var(--r-md);padding:16px 20px;">
            <div style="display:flex;align-items:start;gap:12px;">
              <div style="background:var(--c-brand-soft);color:var(--c-brand);width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;">&#11088;</div>
              <div style="flex:1;">
                <h3 style="font-size:clamp(14px,1.8vw,15px);font-weight:700;color:var(--c-text);margin:0 0 6px;">Verifique a reputa\u00e7\u00e3o do vendedor</h3>
                <p style="font-size:clamp(13px,1.5vw,14px);color:var(--c-text-sub);line-height:1.6;margin:0;">
                  {detectStore(post.data.affiliateUrl) === 'Mercado Livre' && 'Procure vendedores com selo MercadoL\u00edder Platinum e mais de 95% de avalia\u00e7\u00f5es positivas.'}
                  {detectStore(post.data.affiliateUrl) === 'Amazon' && 'Prefira produtos vendidos e entregues pela Amazon ou vendedores com avalia\u00e7\u00e3o acima de 4.5 estrelas.'}
                  {detectStore(post.data.affiliateUrl) === 'Magalu' && 'Verifique a nota do vendedor (acima de 4 estrelas). Vendedores oficiais t\u00eam o selo "Vendido e entregue por Magazine Luiza".'}
                  {!['Mercado Livre', 'Amazon', 'Magalu'].includes(detectStore(post.data.affiliateUrl)) && 'Busque vendedores com alta reputa\u00e7\u00e3o, milhares de vendas e tempo significativo de cadastro na plataforma.'}
                </p>
              </div>
            </div>
          </div>
          <div style="background:#fff;border:1px solid var(--c-border);border-left:4px solid var(--c-brand);border-radius:var(--r-md);padding:16px 20px;">
            <div style="display:flex;align-items:start;gap:12px;">
              <div style="background:var(--c-brand-soft);color:var(--c-brand);width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;">&#8617;&#65039;</div>
              <div style="flex:1;">
                <h3 style="font-size:clamp(14px,1.8vw,15px);font-weight:700;color:var(--c-text);margin:0 0 6px;">Leia a pol\u00edtica de devolu\u00e7\u00e3o</h3>
                <p style="font-size:clamp(13px,1.5vw,14px);color:var(--c-text-sub);line-height:1.6;margin:0;">Voc\u00ea tem 7 dias para desistir da compra (CDC). Verifique se h\u00e1 "troca gr\u00e1tis" ou se voc\u00ea arcar\u00e1 com o frete de retorno antes de finalizar.</p>
              </div>
            </div>
          </div>
          <div style="background:#fff;border:1px solid var(--c-border);border-left:4px solid var(--c-brand);border-radius:var(--r-md);padding:16px 20px;">
            <div style="display:flex;align-items:start;gap:12px;">
              <div style="background:var(--c-brand-soft);color:var(--c-brand);width:36px;height:36px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px;">&#128179;</div>
              <div style="flex:1;">
                <h3 style="font-size:clamp(14px,1.8vw,15px);font-weight:700;color:var(--c-text);margin:0 0 6px;">Use pagamento dentro da plataforma</h3>
                <p style="font-size:clamp(13px,1.5vw,14px);color:var(--c-text-sub);line-height:1.6;margin:0;">
                  {detectStore(post.data.affiliateUrl) === 'Mercado Livre' && 'Sempre pague via Mercado Pago para ter prote\u00e7\u00e3o na compra.'}
                  {detectStore(post.data.affiliateUrl) === 'Amazon' && 'Pague via sistema da Amazon para ter cobertura da Garantia A-Z.'}
                  {detectStore(post.data.affiliateUrl) === 'Magalu' && 'Use o sistema de pagamento do Magalu \u2014 cart\u00e3o de cr\u00e9dito oferece chargeback em caso de problemas.'}
                  {!['Mercado Livre', 'Amazon', 'Magalu'].includes(detectStore(post.data.affiliateUrl)) && 'Sempre pague pelo sistema oficial da plataforma. Cart\u00e3o de cr\u00e9dito oferece prote\u00e7\u00e3o extra com possibilidade de contesta\u00e7\u00e3o.'}
                </p>
              </div>
            </div>
          </div>
          <div style="background:linear-gradient(135deg,#f0f4ff,#e8f0fe);border:1px solid var(--c-brand);border-radius:var(--r-md);padding:16px;text-align:center;margin-top:8px;">
            <p style="font-size:13px;color:var(--c-text-sub);margin:0 0 10px;">Mais d\u00favidas sobre compras online?</p>
            <a href="/faq" class="btn-cta-primary">
              Ver Perguntas Frequentes
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <style>
    .post-narrow {
      max-width: 820px;
      margin: 0 auto;
      width: 100%;
    }

    .post-content-grid {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 48px;
      align-items: start;
      max-width: 1100px;
      margin: 0 auto;
      width: 100%;
    }
    .post-sidebar { position: sticky; top: 88px; }

    @media (max-width: 768px) {
      .post-narrow {
        max-width: 100% !important;
        width: 100%;
        overflow-x: hidden;
      }
      .post-content-grid {
        display: block !important;
        max-width: 100% !important;
        overflow-x: hidden;
      }
      .post-sidebar { position:static; margin-top:40px; }
      .product-box-final { padding:24px 16px; }
