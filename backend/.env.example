# ========================================
# AchadoCerto.VIP - Configuração Backend
# ========================================
# IMPORTANTE: Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA commite o arquivo .env real no Git!

# ⭐ GROQ API - IA Real Integrada
# Obtenha sua chave em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1

# ⭐ SERPER.DEV - Busca no Google (Opcional)
# Obtenha em: https://serper.dev/api-key (2500/mês grátis)
SERPER_API_KEY=sua_chave_serper_aqui

# RapidAPI (Mercado Livre)
# Obtenha em: https://rapidapi.com/belchiorarkad-FqvHs2EDOtP/api/mercado-libre7/
RAPIDAPI_KEY=sua_chave_rapidapi_aqui
RAPIDAPI_HOST=mercado-libre7.p.rapidapi.com

# Server Config
PORT=3001
NODE_ENV=development

# CORS (URLs permitidas)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://achadocerto.vip

# Cache (em minutos)
CACHE_TIME=30

# ========================================
# CONFIGURAÇÃO INICIAL:
# 1. Copie: cp .env.example .env (Windows: copy .env.example .env)
# 2. Preencha as chaves acima com valores reais
# 3. O arquivo .env está no .gitignore (seguro)
# ========================================

