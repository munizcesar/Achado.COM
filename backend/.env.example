# CONFIGURAÇÃO DO GROQ API
# =================================
# 
# Para obter sua API Key:
# 1. Acesse: https://console.groq.com
# 2. Faça login com Google ou GitHub
# 3. Vá em Settings (canto superior direito)
# 4. Copie a API Key (começa com "gsk_")
# 5. Cole no valor de GROQ_API_KEY abaixo
#
# IMPORTANTE: Nunca compartilhe sua chave!
#

GROQ_API_KEY=COLE_SUA_API_KEY_AQUI

# Modelo Groq a usar (deixe como está)
# Opções: mixtral-8x7b-32768 (mais rápido), llama2-70b-4096 (mais poderoso)
GROQ_MODEL=mixtral-8x7b-32768

# Temperatura (0-1, deixe como está)
# 0 = respostas mais determinísticas
# 1 = respostas mais criativas
GROQ_TEMPERATURE=0.7
